{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/Dockerfile.web",
    "watchPatterns": ["web/**", "docker/Dockerfile.web"]
  },
  "deploy": {
    "healthcheckPath": "/login",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1
  }
}

# =====================================================================================
# STAGING ONLY - every value below is a dummy that exists only inside the local mock.
# No real credentials, no real phone numbers, no real customer data. Safe to commit.
# =====================================================================================

# --- n8n instance ---
N8N_ENCRYPTION_KEY=staging-only-encryption-key-0123456789abcdef
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_SECURE_COOKIE=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false
GENERIC_TIMEZONE=Africa/Lagos
TZ=Africa/Lagos
N8N_WEBHOOK_URL=http://localhost:5678/
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all

# --- Google Sheets (mock) ---
GOOGLE_SHEETS_ID=staging-sheet-id

# --- Telegram (mock) ---
TELEGRAM_CHAT_ID=-1009999999901

# --- WhatsApp Cloud API (mock) ---
WHATSAPP_ACCESS_TOKEN=staging-wa-token
WHATSAPP_PHONE_NUMBER_ID=100000000000001
WHATSAPP_VERIFY_TOKEN=staging-verify-token
WHATSAPP_APP_SECRET=staging-app-secret-not-real
WHATSAPP_GRAPH_VERSION=v23.0
WA_TEMPLATE_LANG=en
WA_MAX_PER_RUN=40
# Approved-template names. Two are intentionally LEFT UNSET (REENGAGE_21, NURTURE_BUYER_D5)
# so staging proves that an unconfigured template blocks the send instead of falling back to free-form text.
WA_TPL_WELCOME_D1=eki_test_welcome_d1
WA_TPL_WELCOME_D2=eki_test_welcome_d2
WA_TPL_WELCOME_D3=eki_test_welcome_d3
WA_TPL_REENGAGE_7=eki_test_reengage_7
WA_TPL_REENGAGE_14=eki_test_reengage_14
WA_TPL_NURTURE_VENDOR_D1=eki_test_vendor_d1
WA_TPL_NURTURE_VENDOR_D2=eki_test_vendor_d2
WA_TPL_NURTURE_VENDOR_D3=eki_test_vendor_d3
WA_TPL_NURTURE_VENDOR_D7=eki_test_vendor_d7
WA_TPL_NURTURE_VENDOR_D14=eki_test_vendor_d14
WA_TPL_NURTURE_BUYER_D1=eki_test_buyer_d1
WA_TPL_NURTURE_BUYER_D3=eki_test_buyer_d3
WA_TPL_WAITLIST_CONFIRM=eki_test_waitlist_confirm

# --- AI (OpenAI-compatible; mock) ---
AI_API_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=staging-ai-key
AI_MODEL=llama-3.3-70b-versatile

# --- Email (Resend; mock). .invalid is a reserved TLD: nothing can ever be delivered ---
RESEND_API_KEY=re_staging_key
RESEND_FROM_EMAIL=Eki Staging <noreply@staging.invalid>
TEAM_EMAIL=team@staging.invalid

# --- Public links used in messages ---
APP_DOWNLOAD_LINK=https://staging.invalid/eki
APP_VENDOR_LINK=https://staging.invalid/eki/sell
FEEDBACK_FORM_URL=https://staging.invalid/feedback
FEEDBACK_REWARD_TEXT=
APP_STORE_REVIEW_URL=https://staging.invalid/ios-review
PLAY_STORE_REVIEW_URL=https://staging.invalid/android-review

# --- Social ---
AUTOPILOT_STOP=false
BUFFER_API_KEY=staging-buffer-key
BUFFER_PROFILE_ID_TIKTOK=buf_tiktok_staging
BUFFER_PROFILE_ID_INSTAGRAM=buf_instagram_staging
BUFFER_PROFILE_ID_FACEBOOK=buf_facebook_staging
BUFFER_PROFILE_ID_LINKEDIN=buf_linkedin_staging
TWITTER_POSTING_ENABLED=true
APIFY_TOKEN=staging-apify-token
APIFY_TRENDS_ACTOR_ID=staging~trends-actor
APIFY_TRENDS_INPUT_JSON={"maxItems": 30}

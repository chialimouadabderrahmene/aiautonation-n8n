[
  {
    "id": "eki-cred-gsheets",
    "name": "Eki Google Sheets",
    "type": "googleSheetsOAuth2Api",
    "data": {
      "clientId": "staging-client-id",
      "clientSecret": "staging-client-secret",
      "scope": "https://www.googleapis.com/auth/drive.file https://www.googleapis.com/auth/spreadsheets",
      "authUrl": "https://accounts.google.com/o/oauth2/v2/auth",
      "accessTokenUrl": "https://oauth2.googleapis.com/token",
      "grantType": "authorizationCode",
      "authQueryParameters": "access_type=offline&prompt=consent",
      "authentication": "body",
      "sendAdditionalBodyProperties": false,
      "additionalBodyProperties": "{}",
      "ignoreSSLIssues": false,
      "oauthTokenData": { "access_token": "mock-access-token", "refresh_token": "mock-refresh-token", "token_type": "Bearer", "scope": "spreadsheets", "expires_in": 315360000 }
    }
  },
  {
    "id": "eki-cred-telegram",
    "name": "Eki Telegram Bot",
    "type": "telegramApi",
    "data": { "accessToken": "123456789:staging-telegram-token", "baseUrl": "https://api.telegram.org" }
  },
  {
    "id": "eki-cred-webhook-secret",
    "name": "Eki Webhook Shared Secret",
    "type": "httpHeaderAuth",
    "data": { "name": "X-Eki-Webhook-Secret", "value": "staging-shared-secret" }

      "clientId": "staging-x-client",
      "clientSecret": "staging-x-secret",
      "scope": "tweet.write users.read offline.access",
      "authQueryParameters": "",
      "authentication": "header",
      "sendAdditionalBodyProperties": false,
      "additionalBodyProperties": "{}",
      "ignoreSSLIssues": false,
      "oauthTokenData": { "access_token": "mock-x-token", "token_type": "bearer", "expires_in": 315360000 }

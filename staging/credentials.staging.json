  {
    "id": "eki-cred-telegram-secret",
    "name": "Eki Telegram Webhook Secret",
    "type": "httpHeaderAuth",
    "data": { "name": "X-Telegram-Bot-Api-Secret-Token", "value": "staging-telegram-secret" }
  },
  {
    "id": "eki-cred-twitter",
    "name": "Eki Twitter X OAuth2",

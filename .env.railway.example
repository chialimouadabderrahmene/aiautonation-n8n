# =============================================================
# n8n Railway Production - Environment Variables
# =============================================================
# Set these in Railway → n8n service → Variables tab.
# Do NOT commit real secrets to version control.
# =============================================================

# --- Database (Railway PostgreSQL references) ---
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=${{Postgres.PGHOST}}
DB_POSTGRESDB_PORT=${{Postgres.PGPORT}}
DB_POSTGRESDB_DATABASE=${{Postgres.PGDATABASE}}
DB_POSTGRESDB_USER=${{Postgres.PGUSER}}
DB_POSTGRESDB_PASSWORD=${{Postgres.PGPASSWORD}}

# --- n8n Host ---
N8N_HOST=n8n-production-c3b7.up.railway.app
N8N_PROTOCOL=https
N8N_PORT=5678
WEBHOOK_URL=https://n8n-production-c3b7.up.railway.app/

# --- Security ---
N8N_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX
N8N_SECURE_COOKIE=true
N8N_RUNNERS_ENABLED=true

# --- Timezone ---
GENERIC_TIMEZONE=Africa/Lagos
TZ=Africa/Lagos

# --- AI Content Generation (Groq - free tier) ---
GROQ_API_KEY=gsk_your-groq-api-key

# --- Google Sheets ---
GOOGLE_SHEETS_ID=your-spreadsheet-id-from-url

# --- Telegram Bot ---
TELEGRAM_CHAT_ID=your-telegram-chat-id

# --- Buffer (Social Posting) ---
BUFFER_API_KEY=your-buffer-access-token
BUFFER_PROFILE_ID=your-buffer-profile-id

# --- WhatsApp Cloud API ---
WHATSAPP_ACCESS_TOKEN=your-permanent-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=any-secret-string-you-choose
WHATSAPP_APP_SECRET=your-app-secret

# --- Resend (Email) ---
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@yourdomain.com

# --- Apify (Web Scraping for Intelligence Engine) ---
APIFY_TOKEN=your-apify-token

# --- Team Email for Reports ---
TEAM_EMAIL=team@eki.app
APP_DOWNLOAD_LINK=https://eki.app/download

# --- Autopilot Controls ---
AUTOPILOT_SOCIAL_POSTING=false
AUTOPILOT_STOP=false
MAX_POSTS_PER_DAY=3

# SUPERSEDED: these variables are generated by the Control Center (see docs/N8N_SETUP.md).
# This file documents what the workflows read; do not fill it in by hand for normal operation.
# =====================================================================================
# Eki n8n automation - environment variables
# Set these in Railway -> n8n service -> Variables. Do NOT commit real secrets.
# Every variable a workflow reads through $env is listed here; `node tools/validate-workflows.js`
# fails when a workflow uses one that is missing. Full reference: docs/env-vars.md
# Legend:  REQUIRED = workflows fail without it   |  EXTERNAL DEPENDENCY = needs an account/approval you must create
# =====================================================================================

# ---- n8n platform (pinned image: docker.n8n.io/n8nio/n8n:2.40.7) ----------------------
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=${{Postgres.PGHOST}}
DB_POSTGRESDB_PORT=${{Postgres.PGPORT}}
DB_POSTGRESDB_DATABASE=${{Postgres.PGDATABASE}}
DB_POSTGRESDB_USER=${{Postgres.PGUSER}}
DB_POSTGRESDB_PASSWORD=${{Postgres.PGPASSWORD}}

N8N_HOST=your-n8n-service.up.railway.app
N8N_PROTOCOL=https
N8N_PORT=5678
# Base URL for webhooks (trailing slash required). Replaces the deprecated WEBHOOK_URL.
N8N_WEBHOOK_URL=https://your-n8n-service.up.railway.app/

# 64 hex chars: openssl rand -hex 32   -> back it up; losing it makes every saved credential unreadable
N8N_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX
N8N_SECURE_COOKIE=true
# REQUIRED. All workflows read config/secrets through $env.*; n8n 2.x blocks that by default.
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# One timezone for every workflow schedule and date calculation (decision: Africa/Lagos, WAT UTC+1, no DST)
GENERIC_TIMEZONE=Africa/Lagos
TZ=Africa/Lagos

# Execution data contains phone numbers and message text: keep failures only, prune after 14 days
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336

# ---- Business configuration -----------------------------------------------------------
# REQUIRED: first day of the 30-day content calendar (YYYY-MM-DD). Workflow 01 refuses to run without it.
LAUNCH_DATE=YYYY-MM-DD
# Canonical public URLs (same values the mobile app ships: EXPO_PUBLIC_APP_DOWNLOAD_LINK / public web URL)
APP_DOWNLOAD_LINK=https://culinarytales.app
APP_VENDOR_LINK=https://culinarytales.app/sell
# Optional wa.me click-to-chat link offered in Instagram DMs (workflow 17)
WHATSAPP_CTA_LINK=
# EXTERNAL DEPENDENCY: feedback survey (Tally/Typeform/Google Form) used by workflow 08. No PII is ever put in the link.
FEEDBACK_FORM_URL=
# Optional reward sentence in feedback emails. Leave EMPTY unless a reward really exists and is fulfilled.
FEEDBACK_REWARD_TEXT=
# EXTERNAL DEPENDENCY: store review links (optional, workflow 08 positive feedback)
APP_STORE_REVIEW_URL=
PLAY_STORE_REVIEW_URL=

# ---- Google Sheets (database) ---------------------------------------------------------
# REQUIRED. ID from the spreadsheet URL. Tabs/columns: schemas/google-sheets-schema.md
GOOGLE_SHEETS_ID=

# ---- Telegram (team alerts, approvals, error workflow) ----------------------------------
# REQUIRED. Numeric chat id of the team group (negative for groups)
TELEGRAM_CHAT_ID=

# ---- AI provider (ONE OpenAI-compatible endpoint for every workflow) ---------------------
# Default = Groq. For OpenAI use AI_API_BASE_URL=https://api.openai.com/v1 and AI_MODEL=gpt-4o (or gpt-4o-mini).
AI_API_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile

# ---- WhatsApp Cloud API (EXTERNAL DEPENDENCY: verified Meta Business + phone number) ------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; must match the "Verify token" in the Meta webhook configuration
WHATSAPP_VERIFY_TOKEN=
# Meta app secret: used to verify X-Hub-Signature-256 on every incoming webhook. Missing = ALL incoming messages rejected.
WHATSAPP_APP_SECRET=
# Verify the currently supported Graph API version in Meta's changelog before go-live
WHATSAPP_GRAPH_VERSION=v23.0
WA_TEMPLATE_LANG=en
# Safety cap: max WhatsApp template sends per workflow run
WA_MAX_PER_RUN=40

# Approved message-template NAMES (EXTERNAL DEPENDENCY: create + get each template approved in WhatsApp Manager).
# Leave a name empty and that step is BLOCKED (nothing is sent, the team gets one Telegram alert).
# Template texts and variables: docs/whatsapp-templates.md
WA_TPL_WELCOME_D1=
WA_TPL_WELCOME_D2=
WA_TPL_WELCOME_D3=
WA_TPL_REENGAGE_7=
WA_TPL_REENGAGE_14=
WA_TPL_REENGAGE_21=
WA_TPL_NURTURE_VENDOR_D1=
WA_TPL_NURTURE_VENDOR_D2=
WA_TPL_NURTURE_VENDOR_D3=
WA_TPL_NURTURE_VENDOR_D7=
WA_TPL_NURTURE_VENDOR_D14=
WA_TPL_NURTURE_BUYER_D1=
WA_TPL_NURTURE_BUYER_D3=
WA_TPL_NURTURE_BUYER_D5=
WA_TPL_WAITLIST_CONFIRM=

# ---- Email (Resend) --------------------------------------------------------------------
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. Eki <hello@your-verified-domain>
RESEND_FROM_EMAIL=
# Recipient of the weekly reports
TEAM_EMAIL=

# ---- Social autopilot (all OFF by default) ---------------------------------------------
# Keep false until a full week of human-reviewed output has passed.
AUTOPILOT_SOCIAL_POSTING=false
# Emergency kill switch: true halts generation + posting immediately
AUTOPILOT_STOP=false
# EXTERNAL DEPENDENCY: Buffer access token + one profile id per platform (request shape not verified against live Buffer)
BUFFER_API_KEY=
BUFFER_PROFILE_ID_TIKTOK=
BUFFER_PROFILE_ID_INSTAGRAM=
BUFFER_PROFILE_ID_FACEBOOK=
BUFFER_PROFILE_ID_LINKEDIN=
# X/Twitter API posting also needs the "Eki Twitter X OAuth2" credential in n8n
TWITTER_POSTING_ENABLED=false

# ---- Intelligence (optional) ----------------------------------------------------------
# EXTERNAL DEPENDENCY: Apify account + a trend-scraper actor. Workflow 15 does nothing without all three.
APIFY_TOKEN=
APIFY_TRENDS_ACTOR_ID=
APIFY_TRENDS_INPUT_JSON={}

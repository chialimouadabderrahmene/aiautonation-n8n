# Eki AI Automation Control Center — API service
# Copy to .env for local dev. NEVER commit the real .env file.

NODE_ENV=development
PORT=4100

# Standalone Postgres for this project only (see ../docker/docker-compose.yml).
DATABASE_URL=postgresql://automation:automation@localhost:5433/eki_automation

# Redis, shared with the worker's BullMQ queue.
REDIS_URL=redis://localhost:6380

# Comma-separated list of allowed browser origins (the web/ app).
WEB_ORIGIN=http://localhost:3200

# Generate: openssl rand -hex 32
# Encrypts every credential saved through Integrations. Losing this makes
# every stored credential permanently unreadable — back it up, never commit it.
AUTOMATION_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX

# Generate: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET

# Creates the one operator account on first boot only (if no AdminUser exists
# yet). Unset these after first boot; they are not read again once an account
# exists.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Must equal the secret_token passed to Telegram's setWebhook call, so the
# public /api/approvals/telegram/webhook route can verify the request really
# came from Telegram.
TELEGRAM_WEBHOOK_SECRET=

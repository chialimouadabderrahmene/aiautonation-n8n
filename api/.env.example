# Eki AI Automation Control Center — API service (local development).
# In production these are Railway variables (scripts/railway-setup.sh sets them).
# NEVER commit a real .env file.

NODE_ENV=development
PORT=4100
# Internal-only listener (health probes + the optional n8n supervisor below; never exposed publicly).
INTERNAL_PORT=4110

DATABASE_URL=postgresql://automation:automation@localhost:5433/eki_automation?schema=public
REDIS_URL=redis://localhost:6380

# Browser origin of the web app (the web app proxies /api, so this is only a CORS allow-list).
WEB_ORIGIN=http://localhost:3200
# Public URL of the web app: builds OAuth redirect URLs, the Telegram webhook, signed local media links.
PUBLIC_WEB_URL=http://localhost:3200

# openssl rand -hex 32 — encrypts every credential. Losing it = every stored credential unreadable. Back it up.
AUTOMATION_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX
# openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX
# openssl rand -hex 32 — only needed if you still run the optional legacy n8n service (see below).
INTERNAL_API_TOKEN=REPLACE_WITH_64_CHAR_HEX

# Creates the operator account on first boot only.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- OPTIONAL / LEGACY — the native workflow engine executes all 22 workflows directly and
# never needs n8n running. Leave the five variables below unset for a normal deployment. They
# exist only to let an operator keep a legacy n8n instance connected, side-by-side, purely as a
# read-only mirror (e.g. to browse the original workflow diagrams) — nothing functional depends
# on it, and every one of these is absent from REQUIRED_ENV in server.ts.
N8N_INTERNAL_URL=
N8N_PUBLIC_URL=
N8N_SUPERVISOR_URL=
N8N_OWNER_EMAIL=
N8N_OWNER_PASSWORD=

# Media storage (S3-compatible). STORAGE_DRIVER=local + STORAGE_LOCAL_DIR works for single-machine dev only.
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

// Eki AI Automation Control Center — standalone database.
//
// This is a NEW, independent Postgres database for the "ai automation italy"
// project only. It shares nothing with the Eki marketplace's Prisma schema,
// its database, or its migrations. Nothing here is imported by, or imports
// from, ekiapp-backend-main.

generator client {
  provider      = "prisma-client-js"
  // "native" = the developer's machine; "debian-openssl-3.0.x" = the api and
  // worker Docker runtime (Ubuntu 24.04 LTS, OpenSSL 3 — docker/Dockerfile.api
  // and docker/Dockerfile.worker). Without the explicit target Prisma would
  // ship an engine for the build host only and crash on its first query.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- Auth

/// A small, fixed set of operators for this control center. Deliberately not
/// the Eki admin system: this product is standalone (see README/ARCHITECTURE).
enum AdminRole {
  OWNER
  ADMIN
  VIEWER
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  /// OWNER/ADMIN may write; VIEWER is read-only, enforced server-side by
  /// requireWrite() (modules/auth/auth.ts), not just hidden in the UI.
  role         AdminRole @default(OWNER)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

// ---------------------------------------------------------- Integrations

enum IntegrationCategory {
  AI
  ORCHESTRATION
  MESSAGING
  EMAIL
  SOCIAL
  RESEARCH
  MEDIA
}

enum IntegrationStatus {
  NOT_CONFIGURED
  CONFIGURED
  TEST_FAILED
  CONNECTED
  ACTION_REQUIRED
}

/// One row per provider (OpenAI, Runway, Telegram, n8n, ...). Never stores a
/// secret value itself — see EncryptedCredential. `status` is always derived
/// from real test results, never set optimistically on save.
model Integration {
  id                String              @id @default(cuid())
  provider          String              @unique
  category          IntegrationCategory
  status            IntegrationStatus   @default(NOT_CONFIGURED)
  config            Json                @default("{}")
  lastTestedAt      DateTime?
  lastTestOk        Boolean?
  lastTestMessage   String?
  lastTestLatencyMs Int?
  /// "API_KEY" | "OAUTH" | "INFRA" — mirrors the provider registry's authType.
  authType          String              @default("API_KEY")
  /// OAuth providers only: human-readable connected account (e.g. "@ekiapp"),
  /// never a token.
  connectedAccount  String?
  connectedAt       DateTime?
  tokenExpiresAt    DateTime?
  /// Map of n8n credential name -> n8n credential id created from this
  /// integration by the n8n sync (see modules/n8n/credentials.ts).
  n8nCredentialIds  Json                @default("{}")
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  credentials EncryptedCredential[]

  @@index([category])
}

/// Each secret FIELD of a provider (e.g. OpenAI has one field "apiKey";
/// WhatsApp has several) is its own row, AES-256-GCM encrypted with a key
/// derived from AUTOMATION_SECRET_KEY (never committed, never logged).
/// `maskedPreview` (e.g. "sk-...ab12") is the only representation ever
/// returned by the API — the plaintext leaves the encryption module exactly
/// once, at the moment a test-connection call needs it.
model EncryptedCredential {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  fieldName     String
  ciphertext    String
  iv            String
  authTag       String
  maskedPreview String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([integrationId, fieldName])
}

// -------------------------------------------------------------- Workflows

enum WorkflowReadiness {
  READY
  BLOCKED
  ACTION_REQUIRED
}

/// Mirrors one file in ../n8n-workflows/*.json. `requiredProviders` /
/// `optionalProviders` drive the readiness engine; `n8nWorkflowId` is filled
/// in once the workflow has actually been imported into a real n8n instance
/// (scripts/import-n8n-workflows.js) — null means "not imported anywhere".
model WorkflowConfig {
  id                 String            @id @default(cuid())
  key                String            @unique // e.g. "01-ai-content-generation"
  name               String
  category           String
  requiredProviders  String[]
  optionalProviders  String[]
  n8nWorkflowId      String?
  enabled            Boolean           @default(false)
  readiness          WorkflowReadiness @default(BLOCKED)
  readinessDetail    Json              @default("[]")
  lastExecutionAt    DateTime?
  lastExecutionOk    Boolean?
  /// Live n8n state as last observed by the reconcile loop.
  n8nPresent         Boolean           @default(false)
  n8nActive          Boolean           @default(false)
  n8nSyncedAt        DateTime?
  /// Hash of the transformed definition last pushed to n8n; a mismatch means
  /// the workflow in n8n is out of date (credentials changed, file changed).
  n8nDefinitionHash  String?
  /// "manual" (has a Manual Trigger, runnable on demand), "webhook", "error".
  triggerKind        String            @default("manual")
  lastTestRunAt      DateTime?
  lastTestRunOk      Boolean?
  lastTestRunMessage String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  executions AutomationExecution[]
}

enum ExecutionSource {
  N8N
  VIDEO_WORKER
  CONTROL_CENTER
  AUTOMATION_ENGINE
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  FAILED
  CANCELLED
}

/// A unified execution log across n8n workflow runs AND our own video-worker
/// jobs, so Executions/Reports read from one table regardless of source.
model AutomationExecution {
  id                String          @id @default(cuid())
  source            ExecutionSource
  workflowConfigId  String?
  workflowConfig    WorkflowConfig? @relation(fields: [workflowConfigId], references: [id])
  externalId        String? // n8n execution id, or video job id
  trigger           String?
  provider          String?
  status            ExecutionStatus @default(RUNNING)
  startedAt         DateTime        @default(now())
  finishedAt        DateTime?
  durationMs        Int?
  relatedEntityType String?
  relatedEntityId   String?
  error             String?
  retryCount        Int             @default(0)
  /// n8n execution mode (trigger, webhook, cli, error, ...) or worker stage.
  mode              String?

  @@unique([source, externalId])
  @@index([source, status])
  @@index([startedAt])
}

// ------------------------------------------------------------ Video studio

enum VideoJobState {
  QUEUED
  SCRIPT_GENERATING
  STORYBOARD_READY
  VOICE_GENERATING
  VISUAL_GENERATING
  ASSEMBLING
  QUALITY_CHECK
  READY
  FAILED
  CANCELLED
}

enum VideoAssetType {
  VOICEOVER
  SCENE
  SUBTITLES
  MUSIC
  FINAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model VideoProject {
  id                String   @id @default(cuid())
  name              String
  contentType       String // Instagram Reel, TikTok, ...
  topic             String
  prompt            String
  audience          String?
  language          String   @default("en")
  tone              String   @default("Professional")
  durationSec       Int      @default(30)
  aspectRatio       String   @default("9:16")
  visualStyle       String   @default("Realistic")
  voicePreset       String? // ElevenLabs voice id, or "male"/"female" hint
  music             String   @default("none") // none | background | <asset id>
  subtitles         Boolean  @default(true)
  brand             String   @default("Eki")
  cta               String?
  testMode          Boolean  @default(true)
  /// MediaFile id of an uploaded music track, when music != "none".
  musicFileId       String?
  /// Where an approved video is published: any of "instagram", "facebook",
  /// "x", "linkedin". Empty = approval only, publish manually.
  publishTargets    String[] @default([])
  /// Specific ConnectedAccount ids to publish to, in addition to the legacy
  /// default-per-provider targets above — lets one project reach several
  /// accounts of the same platform. Empty = publishTargets behaves exactly
  /// as before (back-compat, no multi-account installs are affected).
  publishAccountIds String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  jobs VideoJob[]
}

model VideoJob {
  id            String        @id @default(cuid())
  projectId     String
  project       VideoProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  state         VideoJobState @default(QUEUED)
  script        Json?
  storyboard    Json?
  caption       String?
  hashtags      String[]      @default([])
  finalVideoUrl String?
  error         String?
  errorStage    String?
  retryCount    Int           @default(0)
  costMetadata  Json?
  /// 0-100, coarse progress for the UI.
  progress      Int           @default(0)
  createdAt     DateTime      @default(now())
  startedAt     DateTime?
  completedAt   DateTime?

  scenes       VideoScene[]
  assets       VideoAsset[]
  approval     Approval?
  publications Publication[]
}

model VideoScene {
  id               String    @id @default(cuid())
  jobId            String
  job              VideoJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  index            Int
  visualPrompt     String
  voiceoverText    String?
  subtitleText     String?
  durationSec      Int       @default(5)
  provider         String    @default("runway")
  providerJobId    String?
  status           String    @default("PENDING") // PENDING | GENERATING | READY | FAILED
  /// Storage key of the downloaded provider clip (never a provider URL — those expire).
  sceneVideoUrl    String?
  /// Storage key of this scene's voiceover audio + its measured length.
  voiceKey         String?
  voiceDurationSec Float?
  error            String?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  @@unique([jobId, index])
}

model VideoAsset {
  id            String         @id @default(cuid())
  jobId         String
  job           VideoJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type          VideoAssetType
  provider      String?
  providerJobId String?
  /// Storage key (object key in the bucket). Resolved to a short-lived signed
  /// URL only when the UI asks for it.
  url           String
  mimeType      String?
  sizeBytes     Int?
  durationSec   Float?
  width         Int?
  height        Int?
  metadata      Json?
  createdAt     DateTime       @default(now())
}

model Approval {
  id                String         @id @default(cuid())
  videoJobId        String         @unique
  videoJob          VideoJob       @relation(fields: [videoJobId], references: [id], onDelete: Cascade)
  channel           String         @default("TELEGRAM")
  status            ApprovalStatus @default(PENDING)
  telegramChatId    String?
  telegramMessageId String?
  note              String?
  rejectionReason   String?
  decidedBy         String?
  decidedAt         DateTime?
  createdAt         DateTime       @default(now())
}

enum PublicationStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
  SKIPPED
  /// Persisted, delayed until `scheduledFor`. Re-checked at publish time (approval, stop, state).
  SCHEDULED
  /// Scheduled, then cancelled by an admin or by a rejected approval. Never publishes.
  CANCELLED
}

/// One row per (approved video, target platform) — or, once `connectedAccountId`
/// is set, one row per (approved video, specific connected account). The old
/// `[videoJobId, target]` uniqueness still holds for legacy/default-account
/// rows (`connectedAccountId` null); Postgres never treats two NULLs as equal,
/// so it does not collide with the new per-account uniqueness below.
model Publication {
  id                 String            @id @default(cuid())
  videoJobId         String
  videoJob           VideoJob          @relation(fields: [videoJobId], references: [id], onDelete: Cascade)
  target             String
  /// Which connected account this was published through. Null = the legacy
  /// single-account-per-provider path (back-compat; unaffected by this field).
  connectedAccountId String?
  connectedAccount   ConnectedAccount? @relation(fields: [connectedAccountId], references: [id])
  status             PublicationStatus @default(PENDING)
  externalId         String?
  externalUrl        String?
  error              String?
  attempts           Int               @default(0)
  createdAt          DateTime          @default(now())
  publishedAt        DateTime?
  /// Scheduled publish time (UTC instant). Null for immediate publishes.
  scheduledFor       DateTime?
  /// IANA zone the schedule was entered in, for display only (the instant is always UTC).
  scheduleTimezone   String?
  /// Bumped on every reschedule/cancel so a stale delayed job can never publish.
  scheduleVersion    Int               @default(0)

  @@index([status, scheduledFor])
  @@unique([videoJobId, target])
  @@unique([videoJobId, connectedAccountId])
  @@index([connectedAccountId])
}

enum ConnectedAccountStatus {
  CONNECTED
  ACTION_REQUIRED
  DISCONNECTED
}

/// One row per social account an admin has connected — the multi-account
/// successor to `Integration`'s single OAuth slot per provider.
/// `Integration` keeps owning the OAuth *app* credentials (client id/secret,
/// shared across every account of that provider); this model owns each
/// individual account's own tokens, AES-256-GCM encrypted the same way
/// (`lib/crypto.ts`), never the Integration vault (so existing single-account
/// installs are untouched).
model ConnectedAccount {
  id                     String                 @id @default(cuid())
  provider               String // "instagram" | "facebook" | "x" | "linkedin" | "tiktok"
  label                  String // admin-facing name, e.g. "@eki.vendors"
  externalAccountId      String // the platform's own id for this account/page
  isDefault              Boolean                @default(false)
  status                 ConnectedAccountStatus @default(CONNECTED)
  tokenCiphertext        String
  tokenIv                String
  tokenAuthTag           String
  refreshTokenCiphertext String?
  refreshTokenIv         String?
  refreshTokenAuthTag    String?
  tokenExpiresAt         DateTime?
  /// Provider-specific extra fields a publish call needs (pageAccessToken,
  /// graphVersion, organizationId, ...) — same shape as Integration.config.
  extra                  Json                   @default("{}")
  connectedAt            DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  publications         Publication[]
  carouselPublications CarouselPublication[]

  @@unique([provider, externalAccountId])
  @@index([provider])
}

/// Uploaded media the admin manages from the Control Center (music beds).
model MediaFile {
  id          String   @id @default(cuid())
  kind        String   @default("MUSIC")
  name        String
  storageKey  String
  mimeType    String
  sizeBytes   Int
  durationSec Float?
  createdAt   DateTime @default(now())
}

/// Short-lived server-side OAuth state (CSRF + PKCE verifier, encrypted).
model OAuthState {
  id              String   @id
  provider        String
  codeVerifierEnc String?
  createdAt       DateTime @default(now())
  expiresAt       DateTime
}

/// Liveness + capability reports from background services (worker). The API
/// reads this for the Dashboard's system health — a worker that stopped
/// reporting is OFFLINE, never assumed healthy.
model ServiceHeartbeat {
  id           String   @id // "<service>:<instance>"
  service      String
  instance     String
  startedAt    DateTime
  lastSeenAt   DateTime
  capabilities Json     @default("{}")

  @@index([service, lastSeenAt])
}

// ------------------------------------------------------------------ Misc

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ============================================================================
// NATIVE WORKFLOW ENGINE — replaces n8n at runtime. No external workflow
// platform is required to execute these; n8n/* above remains only for the
// legacy workflows not yet ported (see docs/WORKFLOW_ENGINE.md for status).
// ============================================================================

enum EngineWorkflowCategory {
  SYSTEM
  CONTENT
  LEAD_AUTOMATION
  WHATSAPP
  SOCIAL
  AI
  REPORTING
}

enum EngineTriggerType {
  WEBHOOK
  EVENT
  CRON
  MANUAL
}

enum EngineVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// A workflow identity. The executable logic lives in its PUBLISHED EngineWorkflowVersion —
/// editing never mutates a published version in place (new versions only), so an in-flight
/// execution always finishes against the exact definition it started with.
model EngineWorkflow {
  id               String                  @id @default(cuid())
  key              String                  @unique // e.g. "lead-capture-webhook"
  name             String
  description      String?
  category         EngineWorkflowCategory
  triggerType      EngineTriggerType
  /// WEBHOOK: { path }. EVENT: { eventType }. CRON: { cron, timezone }. MANUAL: {}.
  triggerConfig    Json
  enabled          Boolean                 @default(false)
  currentVersionId String?                 @unique
  createdBy        String
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  currentVersion EngineWorkflowVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions       EngineWorkflowVersion[] @relation("AllVersions")
  executions     EngineExecution[]
  schedule       EngineScheduledTrigger?

  @@index([triggerType, enabled])
}

/// One immutable published (or draft/archived) revision of a workflow's definition.
/// `definition` is validated against the engine's Zod schema (modules/engine/definition.ts)
/// before it can ever be set to PUBLISHED — see workflow-versions route.
model EngineWorkflowVersion {
  id          String              @id @default(cuid())
  workflowId  String
  workflow    EngineWorkflow      @relation("AllVersions", fields: [workflowId], references: [id], onDelete: Cascade)
  version     Int
  status      EngineVersionStatus @default(DRAFT)
  definition  Json
  notes       String?
  createdBy   String
  createdAt   DateTime            @default(now())
  publishedAt DateTime?
  publishedBy String?

  currentFor EngineWorkflow?  @relation("CurrentVersion")
  executions EngineExecution[]

  @@unique([workflowId, version])
  @@index([workflowId, status])
}

enum EngineExecutionStatus {
  QUEUED
  RUNNING
  WAITING
  RETRYING
  SUCCEEDED
  FAILED
  CANCELLED
}

// --------------------------------------------------------- Brand Brain
//
// A reusable, persistent brand-voice and audience-vocabulary profile.
// `modules/brand/loader.ts` reads the active row of each and injects it into
// every script/slide-copy generation call automatically — nobody retypes
// brand/tone/vocabulary per request. `isActive` keeps exactly one profile of
// each kind "live" at a time; every save already goes through `recordAudit`,
// so AuditLog is this model's change history (no separate version table).

model BrandProfile {
  id                String   @id @default(cuid())
  name              String   @default("Default")
  isActive          Boolean  @default(false)
  voiceAdjectives   String[] @default([])
  tone              String?
  formality         String?
  sentenceStyle     String?
  preferredPhrases  String[] @default([])
  bannedWords       String[] @default([])
  ctaStyle          String?
  exampleSentences  String[] @default([])
  /// Hex colors (e.g. "#1A2B3C") for the carousel/slideshow renderer's
  /// background and accents. Optional — the renderer falls back to a
  /// neutral default template when none are set.
  primaryColorHex   String?
  secondaryColorHex String?
  accentColorHex    String?
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive])
}

model AudienceProfile {
  id                String   @id @default(cuid())
  name              String   @default("Default")
  isActive          Boolean  @default(false)
  language          String?
  marketDescription String?
  commonPhrases     String[] @default([])
  objections        String[] @default([])
  painPoints        String[] @default([])
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vocabulary VocabularyEntry[]

  @@index([isActive])
}

/// The literal words the audience uses — slang, product names, pain-point
/// phrasing — queryable and editable one entry at a time, not buried in a
/// paragraph of free text.
model VocabularyEntry {
  id                String          @id @default(cuid())
  audienceProfileId String
  audienceProfile   AudienceProfile @relation(fields: [audienceProfileId], references: [id], onDelete: Cascade)
  term              String
  meaning           String?
  category          String? // "slang" | "product" | "painPoint" | "objection" | "other"
  createdAt         DateTime        @default(now())

  @@unique([audienceProfileId, term])
}

/// One row per save of a BrandProfile or AudienceProfile — the FULL prior
/// state, snapshotted before the update is applied, so rollback can restore
/// it exactly. One table for both kinds (discriminated by `profileType`)
/// rather than two near-identical ones.
model ProfileVersion {
  id          String   @id @default(cuid())
  profileType String // "brand" | "audience"
  profileId   String
  snapshot    Json
  createdBy   String
  createdAt   DateTime @default(now())

  @@index([profileType, profileId, createdAt])
}

// ------------------------------------------------------------- Carousels
//
// Parallel to VideoProject/VideoJob/VideoScene/Approval, not merged into
// them: a carousel's parent is a set of rendered images, not a rendered
// video, and Publication/Approval's required `videoJobId` would need a
// breaking migration to accept either. Same lifecycle shape, same brand
// voice/audience vocabulary injection, same Telegram approval pattern.

model CarouselProject {
  id                String   @id @default(cuid())
  name              String
  topic             String
  prompt            String
  audience          String?
  language          String   @default("en")
  tone              String   @default("Professional")
  brand             String   @default("Eki")
  cta               String?
  slideCount        Int      @default(6)
  platform          String   @default("instagram") // drives export dimensions
  /// Where an approved carousel is published: any of "instagram", "facebook",
  /// "x", "linkedin". Empty = approval only, publish manually. Mirrors
  /// VideoProject.publishTargets.
  publishTargets    String[] @default([])
  /// Specific ConnectedAccount ids to publish to, in addition to
  /// publishTargets — mirrors VideoProject.publishAccountIds.
  publishAccountIds String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  jobs CarouselJob[]
}

enum CarouselJobState {
  QUEUED
  SCRIPT_GENERATING
  RENDERING
  QUALITY_CHECK
  READY
  FAILED
  CANCELLED
}

/// One run of one workflow version. `context` is the step-output variable bag, persisted
/// after every step — a crashed worker resumes from the last committed step instead of
/// re-running (or losing) anything. `idempotencyKey` is globally unique: the same trigger
/// event can never produce two executions.
model EngineExecution {
  id             String                 @id @default(cuid())
  workflowId     String
  workflow       EngineWorkflow         @relation(fields: [workflowId], references: [id])
  versionId      String
  version        EngineWorkflowVersion  @relation(fields: [versionId], references: [id])
  status         EngineExecutionStatus  @default(QUEUED)
  triggerType    EngineTriggerType
  triggerPayload Json
  idempotencyKey String                 @unique
  correlationId  String
  context        Json                   @default("{}")
  cursorStepKey  String?
  attempt        Int                    @default(1)
  maxAttempts    Int                    @default(3)
  nextRetryAt    DateTime?
  deadLetter     Boolean                @default(false)
  error          String?
  startedAt      DateTime               @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  requestedBy    String?
  /// Set when this execution is a manual replay of a dead-lettered one.
  replayOfId     String?

  steps EngineStepExecution[]

  @@index([workflowId, status])
  @@index([status, startedAt])
  @@index([deadLetter, status])
  @@index([nextRetryAt])
}

enum EngineStepStatus {
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

/// One attempt of one step within an execution. Kept even for steps that later retry, so the
/// full history (including failed attempts) is visible — never overwritten.
model EngineStepExecution {
  id          String            @id @default(cuid())
  executionId String
  execution   EngineExecution   @relation(fields: [executionId], references: [id], onDelete: Cascade)
  stepKey     String
  stepIndex   Int
  type        String // "action" | "condition" | "delay" | "parallel"
  attempt     Int               @default(1)
  status      EngineStepStatus
  input       Json?
  output      Json?
  error       String?
  startedAt   DateTime          @default(now())
  finishedAt  DateTime?
  durationMs  Int?

  @@unique([executionId, stepKey, attempt])
  @@index([executionId, stepIndex])
}

enum EngineOutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

/// Transactional outbox: a business action writes the row that caused a trigger (e.g. a Lead)
/// AND its EngineOutboxEvent in the SAME db transaction, so the event can never be lost between
/// the commit and the queue publish — a relay (modules/engine/outbox.ts) polls PENDING rows and
/// enqueues them, retrying indefinitely (at-least-once) until Redis/the queue answers.
model EngineOutboxEvent {
  id          String              @id @default(cuid())
  eventType   String
  payload     Json
  dedupeKey   String?             @unique
  status      EngineOutboxStatus  @default(PENDING)
  attempts    Int                 @default(0)
  lastError   String?
  createdAt   DateTime            @default(now())
  publishedAt DateTime?

  @@index([status, createdAt])
}

/// Durable cron schedule for one CRON-trigger workflow. `nextRunAt` is always in the future
/// once set; the relay locks a row (lockedAt) before firing so two instances of the API can
/// never double-fire the same tick.
model EngineScheduledTrigger {
  id          String         @id @default(cuid())
  workflowId  String         @unique
  workflow    EngineWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  cron        String
  timezone    String         @default("UTC")
  nextRunAt   DateTime
  lastRunAt   DateTime?
  lastRunOk   Boolean?
  lockedAt    DateTime?
  lockedBy    String?
  enabled     Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([enabled, nextRunAt])
}

// ---------------------------------------------------- Native business entities
// Replace Google Sheets as the system of record for the ported workflows below
// (handbook requirement: durable, queryable state — not a spreadsheet).

enum LeadStatus {
  NEW
  WELCOMED
  CONTACTED
  CONVERTED
  DEAD
  /// Replied STOP on WhatsApp. whatsappOptIn is also set false — the engagement/nurture/welcome
  /// sequences already exclude whatsappOptIn=false leads, but this status is kept distinct too
  /// so it is visible on the lead itself, not just inferred from the opt-in flag.
  UNSUBSCRIBED
}

/// Which n8n-nurture-sequence track a lead belongs to (workflow 19's "VENDOR"/"BUYER" split).
/// Defaults to UNKNOWN: the nurture sequence deliberately skips a lead until this is set
/// explicitly — it never guesses, since sending the wrong track's template would be worse than
/// not sending one at all.
enum LeadType {
  UNKNOWN
  VENDOR
  BUYER
}

model EngineLead {
  id             String     @id @default(cuid())
  name           String?
  email          String?
  phone          String     @unique
  source         String?
  market         String?
  status         LeadStatus @default(NEW)
  leadType       LeadType   @default(UNKNOWN)
  whatsappOptIn  Boolean    @default(true)
  welcomedAt     DateTime?
  lastContactedAt DateTime?
  /// Per-WhatsApp-sequence progress, e.g. {"welcome":{"stage":2,"lastSentAt":"..."}}. Read and
  /// written exclusively by the whatsapp.runSequence action (workflows 05/06/19) — this is what
  /// makes a re-run after a crash resume from exactly the leads not yet at their next stage,
  /// without a dedicated "for each" step type in the engine (see docs/WORKFLOW_ENGINE.md §2).
  sequenceState  Json       @default("{}")
  /// Workflow 13's conversation state machine step (e.g. "greeting", "type_identified",
  /// "unsubscribed") — written only by whatsapp.processInboundMessage.
  conversationStep String?
  /// Set true when the lead's most recent inbound message was classified high-intent
  /// (vendor/buyer self-identification) — drives the Telegram "follow up ASAP" alert.
  highIntent     Boolean    @default(false)
  metadata       Json       @default("{}")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

/// One inbound WhatsApp message and whatever reply it got (workflow 13) — the native
/// replacement for the n8n "WhatsApp Conversations" Google Sheets tab, which likewise logs one
/// row per inbound message with the reply text embedded, not a separate row per direction.
model EngineWhatsAppConversation {
  id               String   @id @default(cuid())
  phone            String
  messageText      String
  replySent        String?
  conversationStep String?
  messageId        String   @unique
  createdAt        DateTime @default(now())

  @@index([phone, createdAt])
}

model EngineWaitlistEntry {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  phone       String?
  wantsEmail  Boolean  @default(true)
  wantsWhatsapp Boolean @default(false)
  emailSentAt DateTime?
  waSentAt    DateTime?
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())

  @@index([createdAt])
}

model EngineReferralCode {
  id             String   @id @default(cuid())
  code           String   @unique
  ownerName      String?
  ownerEmail     String   @unique
  referralCount  Int      @default(0)
  createdAt      DateTime @default(now())

  referrals EngineReferral[]
}

enum ReferralStatus {
  MATCHED
  DUPLICATE
  UNMATCHED
  REWARDED
}

model EngineReferral {
  id             String         @id @default(cuid())
  codeId         String?
  code           EngineReferralCode? @relation(fields: [codeId], references: [id])
  referralCode   String
  refereeEmail   String
  refereeName    String?
  status         ReferralStatus
  rewardSentAt   DateTime?
  createdAt      DateTime       @default(now())

  @@unique([referralCode, refereeEmail])
  @@index([createdAt])
}

enum FeedbackRequestStatus {
  SENT
  RESPONDED
  SKIPPED
}

model EngineFeedbackRequest {
  id          String                 @id @default(cuid())
  leadPhone   String
  email       String?
  status      FeedbackRequestStatus  @default(SENT)
  sentAt      DateTime               @default(now())
  respondedAt DateTime?
  rating      Int?
  comment     String?

  @@unique([leadPhone])
  @@index([status])
}

model EngineWeeklyReportRun {
  id          String   @id @default(cuid())
  periodStart DateTime
  periodEnd   DateTime
  metrics     Json
  recipients  String[]
  sentAt      DateTime @default(now())

  @@index([periodStart])
}

enum ContentDraftStatus {
  DRAFT
  QUEUED
  APPROVED
  REJECTED
  PUBLISHED
}

/// Replaces the n8n workflows' Google Sheets "content calendar" / "social posts" /
/// "content queue" tabs as the system of record for AI-generated content (workflows
/// 01, 02, 18, 21). Each row is one piece of content, regardless of which native
/// workflow produced it — distinguished by `source`.
model EngineContentDraft {
  id          String             @id @default(cuid())
  source      String
  platform    String?
  contentType String?
  body        String
  hashtags    String[]
  status      ContentDraftStatus @default(DRAFT)
  reviewNote  String?
  metadata    Json               @default("{}")
  /// Set only by the content-calendar flow (workflow 01/02): the 1-30 day-number this draft
  /// belongs to, so a Telegram /approve|/reject|/edit <day> command can find it, and so a
  /// day already drafted is never drafted twice.
  dayNumber   Int?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  reviewedAt  DateTime?
  reviewedBy  String?

  @@index([source, status, createdAt])
  @@index([dayNumber])
}

/// The 30-day content plan (workflow 01's "Content Calendar" Google Sheets tab) — one row per
/// day-number, curated by an admin ahead of time. Durable system-of-record, not AI-generated;
/// the AI only drafts the day's actual post FROM this plan.
model EngineContentCalendarEntry {
  dayNumber      Int      @id
  platform       String
  pillar         String?
  topicBrief     String
  suggestedHook  String?
  cta            String?
  targetAudience String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// A commenter/subscriber identified on a social channel (e.g. ManyChat), distinct from
/// EngineLead because it arrives with a platform handle, not necessarily a phone number
/// (workflow 17). Promoted to a full EngineLead only once a phone number is known.
model EngineSocialLead {
  id            String    @id @default(cuid())
  channel       String
  externalId    String
  name          String?
  phone         String?
  lastCommentAt DateTime  @default(now())
  commentCount  Int       @default(1)
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now())

  @@unique([channel, externalId])
}

/// Replaces the n8n workflow's "Intelligence" Google Sheets tab (workflow 15): one row per
/// AI-extracted pattern (a hook, an emotional trigger, or a content format) from trending posts.
model EngineTrendPattern {
  id        String   @id @default(cuid())
  type      String
  content   String
  score     Int      @default(0)
  source    String   @default("apify")
  createdAt DateTime @default(now())

  @@index([type, createdAt])
}

/// Replaces the n8n workflow's "Pain DB" Google Sheets tab (workflow 16): one row per
/// AI-categorized community pain point found in a Reddit search.
model EnginePainPoint {
  id        String   @id @default(cuid())
  pain      String
  category  String
  intensity Int
  persona   String?
  keywords  String[]
  upvotes   Int      @default(0)
  source    String   @default("reddit")
  createdAt DateTime @default(now())

  @@index([category, createdAt])
}

model CarouselJob {
  id          String           @id @default(cuid())
  projectId   String
  project     CarouselProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  state       CarouselJobState @default(QUEUED)
  script      Json?
  caption     String?
  hashtags    String[]         @default([])
  error       String?
  progress    Int              @default(0)
  createdAt   DateTime         @default(now())
  completedAt DateTime?

  slides       CarouselSlide[]
  approval     CarouselApproval?
  publications CarouselPublication[]
}

model CarouselSlide {
  id              String      @id @default(cuid())
  jobId           String
  job             CarouselJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  index           Int
  headline        String
  body            String?
  visualDirection String?
  /// Storage key of the rendered PNG (never a provider URL).
  imageUrl        String?
  createdAt       DateTime    @default(now())

  @@unique([jobId, index])
}

model CarouselApproval {
  id                String         @id @default(cuid())
  carouselJobId     String         @unique
  carouselJob       CarouselJob    @relation(fields: [carouselJobId], references: [id], onDelete: Cascade)
  channel           String         @default("TELEGRAM")
  status            ApprovalStatus @default(PENDING)
  telegramChatId    String?
  telegramMessageId String?
  note              String?
  rejectionReason   String?
  decidedBy         String?
  decidedAt         DateTime?
  createdAt         DateTime       @default(now())
}

/// One row per (approved carousel, target platform) — or, once
/// `connectedAccountId` is set, one row per (approved carousel, specific
/// connected account). Exact mirror of `Publication`, for carousels instead
/// of videos — kept as its own model rather than widening `Publication`
/// because `videoJobId` there is a required FK (see the note above
/// CarouselProject on why carousels are a parallel model, not a reused one).
model CarouselPublication {
  id                 String            @id @default(cuid())
  carouselJobId      String
  carouselJob        CarouselJob       @relation(fields: [carouselJobId], references: [id], onDelete: Cascade)
  target             String
  /// Which connected account this was published through. Null = the legacy
  /// per-provider path (no specific account chosen).
  connectedAccountId String?
  connectedAccount   ConnectedAccount? @relation(fields: [connectedAccountId], references: [id])
  status             PublicationStatus @default(PENDING)
  externalId         String?
  externalUrl        String?
  error              String?
  attempts           Int               @default(0)
  createdAt          DateTime          @default(now())
  publishedAt        DateTime?
  scheduledFor       DateTime?
  scheduleTimezone   String?
  scheduleVersion    Int               @default(0)

  @@index([status, scheduledFor])
  @@unique([carouselJobId, target])
  @@unique([carouselJobId, connectedAccountId])
  @@index([connectedAccountId])
}

// ------------------------------------------------------- WhatsApp onboarding
//
// Keyword -> group invite link -> group/community -> pinned CTA -> this 1:1
// conversation -> signup -> product listing (the compliant flow from the
// pivot gap analysis: the Cloud API cannot read or message inside a group,
// so the actual signup/listing flow runs here, same as today's workflow 13).

enum WhatsAppContactStatus {
  NEW
  AWAITING_ROLE
  SIGNUP_IN_PROGRESS
  LISTING_PRODUCT
  COMPLETE
  UNSUBSCRIBED
}

model WhatsAppContact {
  id               String                @id @default(cuid())
  phone            String                @unique
  name             String?
  role             String? // "vendor" | "buyer", once known
  status           WhatsAppContactStatus @default(NEW)
  entryKeyword     String?
  source           String? // "instagram_comment" | "whatsapp_group" | "direct"
  optIn            Boolean               @default(false)
  /// First time `optIn` turned true — the nurture sequence's day-count
  /// anchor (falls back to `createdAt` for contacts that predate this
  /// field). Native port of n8n workflow 19's `opt_in_at`.
  optInAt          DateTime?
  lastMessageAt    DateTime?
  /// How many nurture-sequence days have been sent (0 = none yet) — native
  /// port of n8n workflow 19's `nurture_day`/`last_nurture`/`last_wa_error`.
  nurtureDay       Int                   @default(0)
  lastNurtureAt    DateTime?
  lastNurtureError String?
  /// Native port of n8n workflow 05's `wa_day` — distinct from nurtureDay:
  /// welcome targets status=NEW opted-in contacts (days 1-3), nurture
  /// targets status=COMPLETE ones (days 1-14) — two different lifecycle
  /// stages that never overlap, not a duplicate tracking axis.
  welcomeDay       Int                   @default(0)
  lastWelcomeAt    DateTime?
  /// Native port of n8n workflow 06's `reengage_step`/`last_reengage` —
  /// re-engages contacts that finished the nurture sequence (see
  /// worker/src/pipeline/whatsapp-engagement.ts for the "finished" check,
  /// computed from nurtureDay rather than a redundant status flag).
  reengageStep     Int                   @default(0)
  lastReengageAt   DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  messages WhatsAppMessage[]
  listings ProductListing[]
}

model WhatsAppMessage {
  id                String          @id @default(cuid())
  contactId         String
  contact           WhatsAppContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  direction         String // "in" | "out"
  body              String
  templateName      String?
  /// Meta's own message id (inbound "wamid...") — a webhook retry carries
  /// the same id, so this unique constraint is the dedup/replay guard:
  /// the handler checks it before processing, never after.
  providerMessageId String?         @unique
  createdAt         DateTime        @default(now())

  @@index([contactId, createdAt])
}

/// Deliberately minimal — name/description/price/category/photos only. No
/// commission rate, reward, or qualification rule is encoded here: those are
/// business decisions this change does not invent (see pivot report, Open
/// questions).
model ProductListing {
  id          String          @id @default(cuid())
  contactId   String
  contact     WhatsAppContact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  name        String?
  description String?
  price       String?
  category    String?
  photoKeys   String[]        @default([])
  status      String          @default("DRAFT") // DRAFT | SUBMITTED | NEEDS_INFO
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

/// Public waitlist signups (native port of n8n workflow 04) — deliberately
/// its own model, not WhatsAppContact: a waitlist signup may give only an
/// email (no phone), which WhatsAppContact's required-unique `phone` can't
/// represent, and it tracks its own referral program (position, code,
/// referral count) that has no equivalent on a contact.
model WaitlistEntry {
  id             String     @id @default(cuid())
  email          String?
  whatsapp       String?
  name           String
  /// 1-based signup order, assigned at creation — never reassigned.
  position       Int
  referralCode   String     @unique
  referralsCount Int        @default(0)
  userType       String // "Vendor" | "Buyer"
  consent        Boolean    @default(false)
  createdAt      DateTime   @default(now())
  referrals      Referral[]

  @@index([email])
  @@index([whatsapp])
}

/// One row per credited referral (native port of n8n workflow 07) — the
/// referrer is a WaitlistEntry (the only place a referralCode exists in
/// this app); `referredEmail` is globally unique so the same new signup
/// can never be credited twice, matching n8n's own duplicate check.
model Referral {
  id               String        @id @default(cuid())
  referrerId       String
  referrer         WaitlistEntry @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  referredEmail    String        @unique
  referredName     String?
  /// "none" | "VIP Access" (3rd referral) | "Free Escrow" (5th referral) — n8n's own milestone thresholds.
  milestoneReached String        @default("none")
  createdAt        DateTime      @default(now())

  @@index([referrerId])
}

/// One row per AI-generated format variant from one content idea — native
/// port of n8n workflow 18. Deliberately a flat review queue (status
/// pending/used), not a new approval state machine: nothing downstream
/// consumes these automatically, the social team picks copy from here
/// manually, same terminal scope as n8n's "queue to sheet" step.
model ContentVariant {
  id        String   @id @default(cuid())
  idea      String
  /// "reel_script" | "tiktok_adaptation" | "carousel" | "story_sequence" | "fb_post" | "hook_variation_N" | "caption_variation_N"
  format    String
  content   String
  status    String   @default("pending") // pending | used
  createdAt DateTime @default(now())

  @@index([idea])
}

// ---------------------------------------------------------- Provider usage & cost
//
// One row per billable provider call attempt. A retry is a new attempt and is recorded as one
// (attempt = n). A duplicate report of the SAME call is rejected by idempotencyKey, so it cannot be
// counted twice. Cost is NULL when it cannot be determined honestly: unknown is never recorded as zero.

enum UsageCostSource {
  /// The provider's own response stated the amount.
  PROVIDER_REPORTED
  /// Computed from the configured ProviderPrice table and the units the provider reported or we sent.
  ESTIMATED_FROM_PRICING
  /// No usable units or no price configured. costAmount is null.
  UNKNOWN
}

model ProviderUsage {
  id             String          @id @default(cuid())
  createdAt      DateTime        @default(now())
  provider       String
  model          String?
  operation      String
  workflowKey    String?
  /// EngineExecution id, AutomationExecution id, or pipeline job id this call belonged to.
  executionRef   String?
  attempt        Int             @default(1)
  status         String // SUCCEEDED | FAILED
  inputTokens    Int?
  outputTokens   Int?
  mediaUnits     Decimal?        @db.Decimal(14, 3)
  /// seconds | characters | credits | requests
  mediaUnitType  String?
  costAmount     Decimal?        @db.Decimal(14, 6)
  currency       String          @default("USD")
  costSource     UsageCostSource
  idempotencyKey String          @unique
  errorCode      String?
  latencyMs      Int?

  @@index([createdAt])
  @@index([provider, createdAt])
  @@index([workflowKey, createdAt])
  @@index([executionRef])
}

/// Configurable unit prices. The newest row whose effectiveFrom has passed wins for a provider,
/// model (or any model when model is null) and unit. There are no built-in prices in the code.
model ProviderPrice {
  id            String   @id @default(cuid())
  provider      String
  model         String?
  /// input_token | output_token | second | character | credit | request
  unit          String
  unitPrice     Decimal  @db.Decimal(14, 8)
  currency      String   @default("USD")
  effectiveFrom DateTime @default(now())
  note          String?
  createdBy     String
  createdAt     DateTime @default(now())

  @@index([provider, unit, effectiveFrom])
}


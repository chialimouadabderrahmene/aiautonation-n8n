# Runtime base: Ubuntu 24.04 LTS + the official Node 22 binary + FFmpeg.
FROM node:22-bookworm-slim AS node

FROM ubuntu:24.04 AS base
ENV DEBIAN_FRONTEND=noninteractive
# ffmpeg/ffprobe do the real assembly and QA; libass (in ffmpeg) needs
# fontconfig + a font to burn subtitles; openssl for Prisma.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates openssl tini wget ffmpeg fontconfig fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/* \
 && fc-cache -f \
 && ffmpeg -hide_banner -filters | grep -q " subtitles " \
 && ffprobe -version | head -1
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

FROM base AS build
WORKDIR /app
COPY worker/package*.json ./
COPY worker/prisma ./prisma
RUN npm ci
COPY worker ./
RUN npx prisma generate && npm run build && npm prune --omit=dev

FROM base AS runtime
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/package*.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/prisma ./prisma
USER ubuntu
EXPOSE 4101
# Real check: /health pings Redis and Postgres and reports ffmpeg/ffprobe.
HEALTHCHECK --interval=15s --timeout=5s --start-period=40s --retries=3 \
  CMD wget -q -O- http://127.0.0.1:${WORKER_HEALTH_PORT:-4101}/health || exit 1
ENTRYPOINT ["tini", "--", "node", "dist/index.js"]

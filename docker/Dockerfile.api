# Runtime base: Ubuntu 24.04 LTS + the official Node 22 binary.
FROM node:22-bookworm-slim AS node

FROM ubuntu:24.04 AS base
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates openssl tini wget \
 && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && node --version

FROM base AS build
WORKDIR /app
COPY api/package*.json ./
# schema must exist before `npm ci` (postinstall runs `prisma generate`).
COPY api/prisma ./prisma
RUN npm ci
COPY api ./
RUN npx prisma generate && npm run build && npm prune --omit=dev

FROM base AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    WORKFLOWS_DIR=/app/n8n-workflows
COPY --from=build /app/package*.json ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY --from=build /app/prisma ./prisma
# The 22 workflow definitions the API imports into n8n (idempotently).
COPY n8n-workflows ./n8n-workflows
COPY docker/api-entrypoint.sh /usr/local/bin/api-entrypoint.sh
RUN chmod 0555 /usr/local/bin/api-entrypoint.sh
# Unprivileged runtime user (ubuntu:24.04 ships "ubuntu", uid 1000).
USER ubuntu
EXPOSE 4100 4110
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=3 \
  CMD wget -q -O- http://127.0.0.1:${PORT:-4100}/health || exit 1
ENTRYPOINT ["tini", "--", "/usr/local/bin/api-entrypoint.sh"]

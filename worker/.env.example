# Eki AI Automation Control Center — video worker (local development).
# Same database, Redis, secret key and storage as the API. NEVER commit a real .env.
NODE_ENV=development
DATABASE_URL=postgresql://automation:automation@localhost:5433/eki_automation?schema=public
REDIS_URL=redis://localhost:6380
# Must equal the API's AUTOMATION_SECRET_KEY (the worker decrypts what the API stored).
AUTOMATION_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX
VIDEO_WORKER_CONCURRENCY=1
WORKER_HEALTH_PORT=4101

STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Requires ffmpeg + ffprobe on PATH (the Docker image installs them).
# Verify a machine with:  node dist/tools/selftest.js

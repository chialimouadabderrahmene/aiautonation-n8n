# Eki AI Automation Control Center — video worker
# Copy to .env for local dev. NEVER commit the real .env file.
# Points at the SAME database and Redis as api/.env — this is not a separate
# system, just a separately-deployed process.

NODE_ENV=development

DATABASE_URL=postgresql://automation:automation@localhost:5433/eki_automation
REDIS_URL=redis://localhost:6380

# Must be the exact same value as api/.env's AUTOMATION_SECRET_KEY — this
# process decrypts credentials the API saved, it does not save its own.
AUTOMATION_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX

VIDEO_WORKER_CONCURRENCY=1

# Local-disk storage for generated assets (voiceover/scene/final MP4s).
# Swap for an S3/R2-backed StorageProvider (src/lib/storage.ts) before
# running at real volume — local disk does not survive a redeploy.
STORAGE_LOCAL_DIR=./storage
STORAGE_PUBLIC_BASE_URL=

# Requires the `ffmpeg` and `ffprobe` binaries on PATH (installed by
# docker/Dockerfile.worker; NOT installed on a bare dev machine by this repo).

                "={{$env.TEAM_EMAIL || 'team@eki.app'}}"
              ]
            },
            {
              "name": "subject",
              "value": "=Eki Weekly Performance Report - {{$json.week_start}}"
            },
            {
              "name": "html",
              "value": "=<h2>Eki Weekly Report</h2><p>Leads: {{$json.total_leads}} | Vendors: {{$json.vendors}} | Buyers: {{$json.buyers}}</p><p>Posts: {{$json.total_posts}} | Avg Engagement: {{$json.avg_engagement}}</p><p>Top Platform: {{$json.top_platform}}</p><hr/><p><b>AI Recommendations:</b><br/>{{$node['GPT-4 Deep Analysis'].json.output.recommendations.join('<br/>')}}</p>"
            }
          ]
        }
      }
    },
    {

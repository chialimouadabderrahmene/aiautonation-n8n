    {
      "id": "4237b787-b4cd-431e-a82d-55f8363307c0",
      "name": "Merge & Analyze",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        0
      ],
      "parameters": {
        "jsCode": "const leads = $input.all()[0].json;\nconst content = $input.all()[1].json;\nconst total_leads = leads.length;\nconst vendors = leads.filter(l => l.user_type === 'vendor').length;\nconst buyers = leads.filter(l => l.user_type === 'buyer').length;\nconst total_posts = content.length;\nconst avg_engagement = content.reduce((s,p) => s + parseInt(p.comments||0) + parseInt(p.saves||0), 0) / (total_posts||1);\nreturn [{json:{\n  week_start: new Date().toISOString().slice(0,10),\n  total_leads, vendors, buyers,\n  total_posts, avg_engagement: Math.round(avg_engagement),\n  top_platform: [...new Set(content.map(p=>p.platform))].sort((a,b) => content.filter(p=>p.platform===b).length - content.filter(p=>p.platform===a).length)[0]\n}}];"
      }
    },
    {
      "id": "3aa1eeb7-e903-43f8-a83e-51ba089e953d",
      "name": "GPT-4 Deep Analysis",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "=Analyze Eki's weekly performance and provide strategic recommendations. Return JSON: {top_3_insights[], recommendations[], content_brief_for_next_week, risk_flags[]}. Data: {{JSON.stringify($json)}}"
            }
          ]
        }
      },
      "credentials": {
        "openAiApi": "openAiApi"
      }
    },
    {
      "id": "d75581ef-8055-4282-8114-c29e1d3414a2",
      "name": "Log Report",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 2,
      "position": [
        1500,
        0
      ],
      "parameters": {
        "operation": "append",
        "documentId": "={{$env.GOOGLE_SHEETS_ID}}",
        "sheetName": "Analytics",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "report_date": "",
            "total_leads": "",
            "vendors": "",
            "buyers": "",
            "posts": "",

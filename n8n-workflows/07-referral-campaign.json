    {
      "parameters": {
        "jsCode": "const norm = (v) => (v === undefined || v === null) ? '' : String(v).trim();\nconst digits = (v) => norm(v).replace(/\\D/g, '');\nconst yes = (v) => ['yes', 'true', '1', 'y'].includes(norm(v).toLowerCase());\nconst hoursSince = (iso) => { const t = Date.parse(norm(iso)); return Number.isNaN(t) ? Infinity : (Date.now() - t) / 3600000; };\nconst daysSince = (iso) => hoursSince(iso) / 24;\nconst nowIso = () => new Date().toISOString();\nconst appLink = () => norm($env.APP_DOWNLOAD_LINK);\nconst vendorLink = () => norm($env.APP_VENDOR_LINK) || appLink();\nconst ref = $('Validate Referral').first().json.referral;\nconst referrals = $('Read Referrals').all().map((i) => i.json);\nconst referrer = $input.all().map((i) => i.json).find((r) => norm(r.referral_code).toUpperCase() === ref.code);\nif (!referrer) return [{ json: { result: 'unmatched', response: { status: 'completed', message: 'Referral code not found; nothing credited.' } } }];\nif (referrals.some((r) => norm(r.referred_email).toLowerCase() === ref.new_email)) return [{ json: { result: 'duplicate', response: { status: 'duplicate', message: 'This referral was already recorded.' } } }];\nconst newCount = (parseInt(referrer.referrals_count, 10) || 0) + 1;\nlet milestone = 'none';\nif (newCount === 3) milestone = 'VIP Access';\nif (newCount === 5) milestone = 'Free Escrow';\nconst appUrl = appLink();\nconst esc = (s) => String(s).replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\nlet subject = ''; let html = '';\nconst referrerName = esc(referrer.name || 'there');\nif (milestone !== 'none') {\n  subject = 'You unlocked a milestone reward on Eki';\n  html = '<h3>Congratulations ' + referrerName + ',</h3><p>Your friend <strong>' + esc(ref.new_name) + '</strong> just registered on Eki using your link.</p><p>That makes ' + newCount + ' referrals - you unlocked <strong>' + esc(milestone) + '</strong>.</p>' + (appUrl ? '<p>Open Eki: ' + esc(appUrl) + '</p>' : '') + '<p>The Eki Team</p>';\n} else {\n  subject = 'Thank you for referring a friend to Eki';\n  html = '<p>Hi ' + referrerName + ',</p><p>Your friend <strong>' + esc(ref.new_name) + '</strong> just joined Eki using your referral code.</p><p>You now have ' + newCount + ' referral(s) in total.</p><p>The Eki Team</p>';\n}\nconst now = nowIso();\nconst canEmail = !!norm(referrer.email) && !!norm($env.RESEND_API_KEY) && !!norm($env.RESEND_FROM_EMAIL);\nreturn [{ json: {\n  result: 'ok', new_count: String(newCount), milestone, referrer_code: ref.code, referrer_email: norm(referrer.email).toLowerCase(),\n  referral_row: { referral_id: 'R-' + Date.now(), referrer_email: norm(referrer.email).toLowerCase(), referred_email: ref.new_email, referral_code: ref.code, timestamp: now, points_credited: '1', status: 'Credited' },\n  send_email: canEmail, email_to: norm(referrer.email).toLowerCase(), email_subject: subject, email_html: html,\n  response: { status: 'success', referrals_count: newCount, milestone_unlocked: milestone, message: 'Referral tracked.' },\n} }];"
      },

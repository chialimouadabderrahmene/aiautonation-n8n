      "parameters": {
        "jsCode": "const norm = (v) => (v === undefined || v === null) ? '' : String(v).trim();\nconst digits = (v) => norm(v).replace(/\\D/g, '');\nconst yes = (v) => ['yes', 'true', '1', 'y'].includes(norm(v).toLowerCase());\nconst hoursSince = (iso) => { const t = Date.parse(norm(iso)); return Number.isNaN(t) ? Infinity : (Date.now() - t) / 3600000; };\nconst daysSince = (iso) => hoursSince(iso) / 24;\nconst nowIso = () => new Date().toISOString();\nconst appLink = () => norm($env.APP_DOWNLOAD_LINK);\nconst vendorLink = () => norm($env.APP_VENDOR_LINK) || appLink();\nconst b = $input.first().json.body || {};\nconst code = norm(b.referral_code || b.ref).toUpperCase();\nconst newEmail = norm(b.new_user_email || b.new_email).toLowerCase();\nconst newName = norm(b.new_user_name || b.new_name) || 'A friend';\nconst errors = [];\nif (!code) errors.push('referral_code (or ref) is required');\nif (!newEmail || !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(newEmail)) errors.push('new_user_email must be a valid email');\nif (errors.length) return [{ json: { valid: false, errors } }];\nreturn [{ json: { valid: true, referral: { code, new_email: newEmail, new_name: newName } } }];"
      },

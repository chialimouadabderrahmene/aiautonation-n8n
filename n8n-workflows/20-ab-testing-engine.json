    {
      "id": "b10bdd56-0a20-4614-ab7b-9c9f043308b1",
      "name": "Analyze Winners",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "jsCode": "const posts = $json;\nconst scored = posts.map(p => ({\n  ...p,\n  engagement_score: (parseInt(p.comments||0)*3 + parseInt(p.saves||0)*2 + parseInt(p.shares||0)*4)\n}));\nscored.sort((a,b) => b.engagement_score - a.engagement_score);\nconst winners = scored.slice(0,3);\nconst losers = scored.slice(-3);\nreturn [\n  {json:{type:'winners', data:winners}},\n  {json:{type:'losers', data:losers}},\n  {json:{type:'insights', summary:`Top hooks: ${winners.map(w=>w.hook).join(', ')}. Top formats: ${winners.map(w=>w.format).join(', ')}`}}\n];"
      }
    },
    {
      "id": "fdc68f1c-f37e-44aa-81e0-08f0b07ebbe4",
      "name": "GPT-4 Insights",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 2,
      "position": [
        900,
        0
      ],
      "parameters": {
        "model": "gpt-4o-mini",
        "messages": {
          "values": [
            {
              "role": "user",
              "content": "=Analyze these winners vs losers from Eki's content. Extract patterns: what hooks, emotions, formats, CTAs drive engagement. Return JSON: {top_hooks[], top_formats[], top_emotions[], recommendations[]}. Data: {{JSON.stringify($json)}}"
            }
          ]
        }
      },
      "credentials": {
        "openAiApi": "openAiApi"
      }
    },
    {
      "id": "bc185b34-4eff-48d3-81ef-7bb23bce8845",

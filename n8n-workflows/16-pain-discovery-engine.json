          }
        }
      }
    },
    {
      "id": "723cd37b-32fe-4cae-80f6-6a7ffbad98ad",
      "name": "Extract Pains",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "jsCode": "const posts = $json.data.children || [];\nreturn posts.slice(0,20).map(p => ({\n  json: {\n    pain: p.data.title,\n    text: p.data.selftext,\n    upvotes: p.data.ups,\n    source: 'reddit'\n  }\n}));"
      }
    },
    {
      "id": "513a79a5-8884-4897-b920-56f86a7d0545",
      "name": "GPT-4 Categorize",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        900,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "nodeCredentialType": "openAiApi",
        "contentType": "json",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "gpt-4o-mini"
            },
            {
              "name": "messages",
              "value": [
                {
                  "role": "user",
                  "content": "Categorize this pain point: vendor/buyer, category (DM_Chaos/Payment_Fraud/Scam_Fear/No_Buyers/Trust), emotional_intensity 1-10. Return JSON:{persona,category,intensity,keywords}"
                }
              ]
            }
          ]
        }
      }
    },

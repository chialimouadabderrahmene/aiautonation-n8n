        300,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://www.reddit.com/r/Nigeria+r/diaspora+r/AfricanFood/search.json?q=foodstuff+vendor+problem&restrict_sr=1&sort=top&t=week",

    {
      "parameters": {
        "jsCode": "const norm = (v) => (v === undefined || v === null) ? '' : String(v).trim();\nconst digits = (v) => norm(v).replace(/\\D/g, '');\nconst yes = (v) => ['yes', 'true', '1', 'y'].includes(norm(v).toLowerCase());\nconst hoursSince = (iso) => { const t = Date.parse(norm(iso)); return Number.isNaN(t) ? Infinity : (Date.now() - t) / 3600000; };\nconst daysSince = (iso) => hoursSince(iso) / 24;\nconst nowIso = () => new Date().toISOString();\nconst appLink = () => norm($env.APP_DOWNLOAD_LINK);\nconst vendorLink = () => norm($env.APP_VENDOR_LINK) || appLink();\nconst tplLang = norm($env.WA_TEMPLATE_LANG) || 'en';\nconst waClean = (s) => norm(s).replace(/[\\r\\n\\t]+/g, ' ').replace(/ {5,}/g, '    ').slice(0, 900) || '-';\n// Business-initiated WhatsApp messages MUST be approved templates. Never free-form text.\nconst buildTemplate = (key, phone, params) => {\n  const name = norm($env['WA_TPL_' + key]);\n  if (!name) return { ok: false, reason: 'template_not_configured:WA_TPL_' + key };\n  const to = digits(phone);\n  if (to.length < 8 || to.length > 15) return { ok: false, reason: 'invalid_phone' };\n  return {\n    ok: true,\n    template: name,\n    payload: {\n      messaging_product: 'whatsapp', recipient_type: 'individual', to, type: 'template',\n      template: { name, language: { code: tplLang }, components: [{ type: 'body', parameters: params.map((p) => ({ type: 'text', text: waClean(p) })) }] },\n    },\n  };\n};\n// Returns '' when the lead may be contacted, otherwise the reason it must NOT be.\nconst notContactableReason = (l) => {\n  if (!yes(l.opt_in)) return 'no_opt_in';\n  if (norm(l.opt_out_at)) return 'opted_out';\n  const st = norm(l.status).toLowerCase();\n  if (['unsubscribed', 'converted', 'churned'].includes(st)) return 'status_' + st;\n  const d = digits(l.phone);\n  if (d.length < 8 || d.length > 15) return 'invalid_phone';\n  return '';\n};\nconst d = $('Dedupe And Build').first().json;\nconst r = d.record;\nconst out = { email_to: '', email_subject: '', email_html: '', wa_payload: null, wa_reason: '' };\nconst from = norm($env.RESEND_FROM_EMAIL);\nif (r.email && norm($env.RESEND_API_KEY) && from) {\n  out.email_to = r.email;\n  out.email_subject = 'You are on the Eki waitlist - position #' + r.position;\n  out.email_html = '<p>Hi ' + r.name.replace(/[<>&]/g, '') + ',</p><p>You are officially #' + r.position + ' on the Eki waitlist.</p><p>Share your personal referral link to move up:</p><p><strong>' + d.ref_link + '</strong></p><p>The Eki Team</p>';\n}\nif (!r.whatsapp) out.wa_reason = 'no_whatsapp';\nelse if (!d.consent) out.wa_reason = 'no_consent';\nelse {\n  const t = buildTemplate('WAITLIST_CONFIRM', r.whatsapp, [r.name, String(r.position), d.ref_link]);\n  if (t.ok) out.wa_payload = t.payload; else out.wa_reason = t.reason;\n}\nreturn [{ json: { ...out, send_email: !!out.email_to, send_wa: !!out.wa_payload, payload: out.wa_payload } }];"
      },

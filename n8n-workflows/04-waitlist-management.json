      "parameters": {
        "jsCode": "const norm = (v) => (v === undefined || v === null) ? '' : String(v).trim();\nconst digits = (v) => norm(v).replace(/\\D/g, '');\nconst yes = (v) => ['yes', 'true', '1', 'y'].includes(norm(v).toLowerCase());\nconst hoursSince = (iso) => { const t = Date.parse(norm(iso)); return Number.isNaN(t) ? Infinity : (Date.now() - t) / 3600000; };\nconst daysSince = (iso) => hoursSince(iso) / 24;\nconst nowIso = () => new Date().toISOString();\nconst appLink = () => norm($env.APP_DOWNLOAD_LINK);\nconst vendorLink = () => norm($env.APP_VENDOR_LINK) || appLink();\nconst b = $input.first().json.body || {};\nconst name = norm(b.name);\nconst email = norm(b.email).toLowerCase();\nconst whatsapp = digits(b.whatsapp || b.phone);\nconst errors = [];\nif (!name) errors.push('name is required');\nif (!email && !whatsapp) errors.push('email or whatsapp is required');\nif (email && !/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) errors.push('email is invalid');\nif (whatsapp && (whatsapp.length < 8 || whatsapp.length > 15)) errors.push('whatsapp must be 8-15 digits (international format, digits only)');\nif (errors.length) return [{ json: { valid: false, errors } }];\nconst consent = b.consent === true || ['true', 'yes', '1'].includes(norm(b.consent).toLowerCase());\nconst ut = norm(b.user_type).toLowerCase();\nreturn [{ json: { valid: true, signup: { name, email, whatsapp, consent, user_type: ut === 'buyer' ? 'Buyer' : 'Vendor' } } }];"
      },

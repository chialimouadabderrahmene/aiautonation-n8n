      "parameters": {
        "jsCode": "const norm = (v) => (v === undefined || v === null) ? '' : String(v).trim();\nconst digits = (v) => norm(v).replace(/\\D/g, '');\nconst yes = (v) => ['yes', 'true', '1', 'y'].includes(norm(v).toLowerCase());\nconst hoursSince = (iso) => { const t = Date.parse(norm(iso)); return Number.isNaN(t) ? Infinity : (Date.now() - t) / 3600000; };\nconst daysSince = (iso) => hoursSince(iso) / 24;\nconst nowIso = () => new Date().toISOString();\nconst appLink = () => norm($env.APP_DOWNLOAD_LINK);\nconst vendorLink = () => norm($env.APP_VENDOR_LINK) || appLink();\nconst s = $('Validate Signup').first().json.signup;\nconst rows = $input.all().map((i) => i.json).filter((r) => norm(r.email) || norm(r.whatsapp));\nconst dup = rows.find((r) => (s.email && norm(r.email).toLowerCase() === s.email) || (s.whatsapp && digits(r.whatsapp) === s.whatsapp));\nif (dup) return [{ json: { is_duplicate: true, response: { status: 'already_registered', position: parseInt(dup.position, 10) || null, referral_code: norm(dup.referral_code), message: 'You are already on the Eki waitlist.' } } }];\nconst base = (s.name.replace(/[^a-zA-Z]/g, '').substring(0, 3).toUpperCase() || 'EKI').padEnd(3, 'X');\nconst code = 'WL-EKI-' + base + '-' + Math.random().toString(36).substring(2, 6).toUpperCase();\nconst position = rows.length + 1;\nconst record = { email: s.email, whatsapp: s.whatsapp, name: s.name, position: String(position), referral_code: code, referrals_count: '0', user_type: s.user_type, signup_date: nowIso().slice(0, 10), consent: s.consent ? 'yes' : 'no' };\nconst base_url = appLink();\nconst refLink = base_url ? base_url + (base_url.includes('?') ? '&' : '?') + 'ref=' + code : code;\nreturn [{ json: { is_duplicate: false, record, ref_link: refLink, consent: s.consent, response: { status: 'success', position, referral_code: code, message: 'Waitlist registration complete.' } } }];"
      },

    {
      "parameters": {
        "jsCode": "// Filter leads who signed up exactly 7 days ago\nconst now = new Date();\nconst items = $input.all();\nconst eligible = [];\n\nfor (const item of items) {\n  const signupDate = new Date(item.json.signup_date);\n  if (isNaN(signupDate.getTime())) continue;\n  \n  const daysSinceSignup = Math.floor((now - signupDate) / (1000 * 60 * 60 * 24));\n  \n  // Send feedback request to users who signed up 7 days ago (± 1 day tolerance)\n  if (daysSinceSignup >= 6 && daysSinceSignup <= 8) {\n    eligible.push({\n      json: {\n        ...item.json,\n        days_since_signup: daysSinceSignup\n      }\n    });\n  }\n}\n\nif (eligible.length === 0) {\n  return [{ json: { empty: true, message: 'No eligible users for feedback request today' } }];\n}\n\nreturn eligible;"
      },
      "id": "c3d4e5f6-3001-4001-8001-000000000803",
      "name": "Filter 7-Day Users",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 100]
    },

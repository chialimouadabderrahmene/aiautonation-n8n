    {
      "parameters": {
        "jsCode": "// Normalize and validate feedback data\nconst body = $input.first().json.body;\n\nconst email = (body.email || '').trim().toLowerCase();\nconst rating = parseInt(body.rating, 10);\nconst comments = (body.comments || '').trim();\nconst wouldRecommend = body.would_recommend === true || body.would_recommend === 'true' || body.would_recommend === 'yes';\n\nif (!email || isNaN(rating) || rating < 1 || rating > 5) {\n  throw new Error('Invalid feedback data: email and rating (1-5) are required');\n}\n\nreturn [{\n  json: {\n    email,\n    rating,\n    comments,\n    would_recommend: wouldRecommend,\n    timestamp: new Date().toISOString(),\n    rating_category: rating >= 4 ? 'positive' : (rating === 3 ? 'neutral' : 'negative')\n  }\n}];"
      },
      "id": "c3d4e5f6-3001-4001-8001-000000000807",
      "name": "Validate Feedback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [260, 520]
    },

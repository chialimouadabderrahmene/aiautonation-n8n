    {
      "parameters": {
        "jsCode": "const norm = (v) => (v === undefined || v === null) ? '' : String(v).trim();\nconst digits = (v) => norm(v).replace(/\\D/g, '');\nconst yes = (v) => ['yes', 'true', '1', 'y'].includes(norm(v).toLowerCase());\nconst hoursSince = (iso) => { const t = Date.parse(norm(iso)); return Number.isNaN(t) ? Infinity : (Date.now() - t) / 3600000; };\nconst daysSince = (iso) => hoursSince(iso) / 24;\nconst nowIso = () => new Date().toISOString();\nconst appLink = () => norm($env.APP_DOWNLOAD_LINK);\nconst vendorLink = () => norm($env.APP_VENDOR_LINK) || appLink();\nconst flag = (v) => ['true', 'yes', '1'].includes(norm(v).toLowerCase());\nconst stopped = () => flag($env.AUTOPILOT_STOP);\nconst autopilotOn = () => flag($env.AUTOPILOT_SOCIAL_POSTING);\nconst bufferProfile = (platform) => norm($env['BUFFER_PROFILE_ID_' + String(platform).toUpperCase()]);\n// Oldest Approved, unpublished draft. API posting ONLY when AUTOPILOT_SOCIAL_POSTING=true and AUTOPILOT_STOP is not set.\nif (stopped()) return [];\nconst rows = $input.all().map((i) => i.json).filter((r) => norm(r.draft_id));\nconst pending = rows.filter((r) => norm(r.status).toLowerCase() === 'approved' && !flag(r.published));\nif (!pending.length) return [];\npending.sort((a, b) => (Date.parse(a.approval_date) || Date.parse(a.created_date) || 0) - (Date.parse(b.approval_date) || Date.parse(b.created_date) || 0));\nconst p = pending[0];\nconst raw = norm(p.platform).toLowerCase();\nconst platform = raw.includes('twitter') || raw === 'x' || raw.startsWith('x/') ? 'twitter' : raw.includes('instagram') ? 'instagram' : raw.includes('facebook') ? 'facebook' : raw.includes('linkedin') ? 'linkedin' : raw.includes('tiktok') ? 'tiktok' : 'other';\nconst text = (norm(p.caption) + (norm(p.hashtags) ? '\\n\\n' + norm(p.hashtags) : '')).trim();\nlet route = 'manual';\nif (autopilotOn()) {\n  if (platform === 'twitter' && norm($env.TWITTER_POSTING_ENABLED).toLowerCase() === 'true') route = 'twitter';\n  else if (['instagram', 'facebook', 'linkedin'].includes(platform) && norm($env.BUFFER_API_KEY) && bufferProfile(platform)) route = 'buffer';\n}\nconst alert = 'Ready to post on ' + platform.toUpperCase() + '\\n\\nCaption:\\n' + norm(p.caption) + '\\n\\nHashtags: ' + (norm(p.hashtags) || 'none') + (norm(p.video_script) ? '\\n\\nVideo script:\\n' + norm(p.video_script) : '') + '\\n\\nRemaining approved posts: ' + (pending.length - 1) + '\\nPost manually, then mark the draft as Published in the sheet.';\nreturn [{ json: { draft_id: norm(p.draft_id), platform, route, text, tweet_text: text.slice(0, 280), buffer_profile: bufferProfile(platform), alert } }];"
      },

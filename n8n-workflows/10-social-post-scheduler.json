    {
      "parameters": {
        "jsCode": "// Select the next post to publish (oldest approved first)\nconst items = $input.all();\n\n// Filter out already published posts\nconst unpublished = items.filter(item => {\n  const published = (item.json.published || '').toString().toLowerCase();\n  return published !== 'true' && published !== 'yes' && published !== '1';\n});\n\nif (unpublished.length === 0) {\n  return [{ json: { empty: true, message: 'All approved posts have been published' } }];\n}\n\n// Sort by date (oldest first)\nunpublished.sort((a, b) => {\n  const dateA = new Date(a.json.created_date || a.json.date || 0);\n  const dateB = new Date(b.json.created_date || b.json.date || 0);\n  return dateA - dateB;\n});\n\nconst nextPost = unpublished[0].json;\nconst platform = (nextPost.platform || 'manual').toLowerCase();\n\n// Determine best posting time based on platform\nlet suggestedTime = '';\nconst hour = new Date().getHours();\nif (platform === 'twitter' || platform === 'x') suggestedTime = 'Now (Twitter peak: 9-11 AM, 1-3 PM)';\nelse if (platform === 'instagram') suggestedTime = 'Now (Instagram peak: 11 AM - 1 PM, 7-9 PM)';\nelse if (platform === 'linkedin') suggestedTime = 'Now (LinkedIn peak: 7-8 AM, 12 PM, 5-6 PM)';\nelse if (platform === 'facebook') suggestedTime = 'Now (Facebook peak: 1-4 PM)';\nelse if (platform === 'tiktok') suggestedTime = 'Now (TikTok peak: 7-9 AM, 12-3 PM, 7-11 PM)';\nelse suggestedTime = 'Now';\n\nreturn [{\n  json: {\n    ...nextPost,\n    platform: platform,\n    caption: nextPost.caption || nextPost.content || '',\n    hashtags: nextPost.hashtags || '',\n    video_script: nextPost.video_script || '',\n    image_url: nextPost.image_url || '',\n    suggested_time: suggestedTime,\n    row_number: nextPost.row_number || nextPost.ROW_NUMBER || '',\n    remaining_posts: unpublished.length - 1\n  }\n}];"
      },

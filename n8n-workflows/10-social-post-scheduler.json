        "jsCode": "const norm = (v) => (v === undefined || v === null) ? '' : String(v).trim();\nconst digits = (v) => norm(v).replace(/\\D/g, '');\nconst yes = (v) => ['yes', 'true', '1', 'y'].includes(norm(v).toLowerCase());\nconst hoursSince = (iso) => { const t = Date.parse(norm(iso)); return Number.isNaN(t) ? Infinity : (Date.now() - t) / 3600000; };\nconst daysSince = (iso) => hoursSince(iso) / 24;\nconst nowIso = () => new Date().toISOString();\nconst appLink = () => norm($env.APP_DOWNLOAD_LINK);\nconst vendorLink = () => norm($env.APP_VENDOR_LINK) || appLink();\nconst src = $('Select Next Post').first().json;\nconst r = $input.first().json || {};\nconst ok = !r.error && ((src.route === 'twitter' && !!(r.data && r.data.id)) || (src.route === 'buffer' && r.success === true));\nreturn [{ json: { ok, draft_id: src.draft_id, error: ok ? '' : String((r.error && (r.error.message || r.error)) || 'provider_reported_failure').slice(0, 200) } }];"
      },

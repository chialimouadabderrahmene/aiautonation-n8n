      "id": "5be5b0cd-562a-4df4-8d41-c741e0a290ad",
      "name": "Read Original Draft",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        780,
        450
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {

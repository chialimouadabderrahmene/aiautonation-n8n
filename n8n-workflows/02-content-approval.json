    {
      "parameters": {
        "chatId": "TELEGRAM_CHAT_ID_PLACEHOLDER",
        "text": "=📝 **Revised Eki Content Draft Ready!**\n\n📅 **Day Number:** {{ $json.day_number }}\n📱 **Platform:** {{ $json.platform }}\n\n🪝 **Revised Hook:** {{ $json.hook }}\n\n📝 **Revised Caption:**\n{{ $json.caption }}\n\n🏷️ **Hashtags:** {{ $json.hashtags }}\n\n🎬 **Revised Video Script:**\n{{ $json.video_script }}\n\n---\nReply with:\n• `/approve {{ $json.day_number }}`\n• `/reject {{ $json.day_number }}`\n• `/edit {{ $json.day_number }} [new feedback]`",
        "additionalFields": {}
      },

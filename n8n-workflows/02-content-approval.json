        "jsCode": "const norm = (v) => (v === undefined || v === null) ? '' : String(v).trim();\nconst digits = (v) => norm(v).replace(/\\D/g, '');\nconst yes = (v) => ['yes', 'true', '1', 'y'].includes(norm(v).toLowerCase());\nconst hoursSince = (iso) => { const t = Date.parse(norm(iso)); return Number.isNaN(t) ? Infinity : (Date.now() - t) / 3600000; };\nconst daysSince = (iso) => hoursSince(iso) / 24;\nconst nowIso = () => new Date().toISOString();\nconst appLink = () => norm($env.APP_DOWNLOAD_LINK);\nconst vendorLink = () => norm($env.APP_VENDOR_LINK) || appLink();\nconst upd = $input.first().json.body || {};\nconst msg = upd.message || upd.edited_message || {};\nconst text = norm(msg.text);\nconst chatId = norm(msg.chat && msg.chat.id);\nconst allowed = norm($env.TELEGRAM_CHAT_ID);\nif (!text) return [{ json: { action: 'ignore', reason: 'no_text' } }];\nif (!allowed || chatId !== allowed) return [{ json: { action: 'ignore', reason: 'unauthorized_chat' } }];\nconst m = text.match(/^\\/(approve|reject|edit)(?:@\\w+)?\\s+(\\d+)(?:\\s+([\\s\\S]+))?$/i);\nif (!m) return [{ json: { action: 'ignore', reason: 'no_command' } }];\nconst action = m[1].toLowerCase();\nconst feedback = norm(m[3]);\nif (action === 'edit' && !feedback) return [{ json: { action: 'ignore', reason: 'edit_needs_feedback' } }];\nreturn [{ json: { action, day_number: parseInt(m[2], 10), feedback } }];"

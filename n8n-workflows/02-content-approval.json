    {
      "parameters": {
        "jsCode": "const originalRow = $input.all().find(row => parseInt(row.json.day_number) === $('Parse Command').first().json.day_number);\nif (!originalRow) {\n  throw new Error('Original draft row not found');\n}\nreturn {\n  original_caption: originalRow.json.caption,\n  original_hook: originalRow.json.hook,\n  original_video_script: originalRow.json.video_script,\n  feedback: $('Parse Command').first().json.feedback,\n  day_number: $('Parse Command').first().json.day_number,\n  platform: originalRow.json.platform\n};"
      },
      "id": "1d234cd3-3245-42ea-af39-1234c2672d62",
      "name": "Merge Original & Feedback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        980,
        450
      ]
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "prompt": {
          "messages": [
            {
              "role": "system",
              "content": "You are a professional social media content creator for Eki. Revise the provided social post draft based on user feedback. Retain the same output JSON structure:\n{\n  \"hook\": \"One scroll-stopping sentence\",\n  \"caption\": \"Engagement caption (50-150 words) with emojis\",\n  \"hashtags\": \"#Hashtags #EkiMarket\",\n  \"video_script\": \"Short-form 30-sec script with visual cues in brackets\"\n}"
            },
            {
              "role": "user",
              "content": "=Original Hook: {{ $json.original_hook }}\nOriginal Caption: {{ $json.original_caption }}\nOriginal Video Script: {{ $json.original_video_script }}\n\nFeedback for revision: {{ $json.feedback }}"
            }
          ]
        },
        "options": {
          "responseFormat": "json_object"
        }
      },
      "id": "2bc34cd3-3245-42ea-af39-1234c2672d63",
      "name": "OpenAI Content Revise",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.6,
      "position": [
        1180,
        450
      ],
      "credentials": {
        "openAiApi": {
          "id": "1",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const aiResponse = JSON.parse($input.first().json.choices[0].message.content);\nreturn {\n  day_number: $('Merge Original & Feedback').first().json.day_number,\n  platform: $('Merge Original & Feedback').first().json.platform,\n  hook: aiResponse.hook,\n  caption: aiResponse.caption,\n  hashtags: aiResponse.hashtags,\n  video_script: aiResponse.video_script,\n  status: 'Draft'\n};"
      },
      "id": "3d234cd3-3245-42ea-af39-1234c2672d64",
      "name": "Parse Revised Output",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,

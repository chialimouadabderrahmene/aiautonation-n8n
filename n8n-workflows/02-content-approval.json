    {
      "parameters": {
        "jsCode": "const norm = (v) => (v === undefined || v === null) ? '' : String(v).trim();\nconst digits = (v) => norm(v).replace(/\\D/g, '');\nconst yes = (v) => ['yes', 'true', '1', 'y'].includes(norm(v).toLowerCase());\nconst hoursSince = (iso) => { const t = Date.parse(norm(iso)); return Number.isNaN(t) ? Infinity : (Date.now() - t) / 3600000; };\nconst daysSince = (iso) => hoursSince(iso) / 24;\nconst nowIso = () => new Date().toISOString();\nconst appLink = () => norm($env.APP_DOWNLOAD_LINK);\nconst vendorLink = () => norm($env.APP_VENDOR_LINK) || appLink();\nconst AI_MODEL = norm($env.AI_MODEL) || 'llama-3.3-70b-versatile';\nconst aiRequest = (system, user, temperature) => ({\n  model: AI_MODEL, temperature: temperature === undefined ? 0.7 : temperature, response_format: { type: 'json_object' },\n  messages: [{ role: 'system', content: system }, { role: 'user', content: user }],\n});\nconst parseAi = (resp) => {\n  const raw = resp && resp.choices && resp.choices[0] && resp.choices[0].message && resp.choices[0].message.content;\n  if (!raw) throw new Error('AI provider returned no content');\n  let s = String(raw).trim();\n  const m = s.match(/```(?:json)?\\s*([\\s\\S]*?)```/);\n  if (m) s = m[1].trim();\n  try { return JSON.parse(s); } catch (e) { throw new Error('AI provider returned invalid JSON: ' + e.message); }\n};\nconst cmd = $('Parse Command').first().json;\nconst rows = $input.all().map((i) => i.json);\nconst orig = rows.find((r) => parseInt(r.day_number, 10) === cmd.day_number);\nif (!orig) throw new Error('Original draft not found for day ' + cmd.day_number);\nconst system = 'You are a professional social media content creator for Eki, a digital marketplace connecting African foodstuff vendors with global buyers. Revise the provided social post draft based on user feedback. Do not invent statistics, testimonials, prices, or guarantees. Retain the same output JSON structure:\\n{\\n  \"hook\": \"One scroll-stopping sentence\",\\n  \"caption\": \"Engagement caption (50-150 words) with emojis\",\\n  \"hashtags\": \"#Hashtags #EkiMarket\",\\n  \"video_script\": \"Short-form 30-sec script with visual cues in brackets\"\\n}';\nconst user = 'Original Hook: ' + norm(orig.hook) + '\\nOriginal Caption: ' + norm(orig.caption) + '\\nOriginal Video Script: ' + norm(orig.video_script) + '\\n\\nFeedback for revision: ' + cmd.feedback;\nreturn [{ json: { day_number: cmd.day_number, platform: norm(orig.platform), ai_request: aiRequest(system, user, 0.7) } }];"
      },

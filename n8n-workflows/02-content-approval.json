{
  "name": "Eki - 02 Content Approval Handler",
  "nodes": [
    {
      "parameters": {
        "path": "content-approval",
        "options": {}
      },
      "id": "e674b321-4f1b-419b-a010-b6f7924c2560",
      "name": "Telegram Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const message = $input.first().json.body.message.text;\nconst matches = message.match(/^\\/(approve|reject|edit)\\s+(\\d+)(?:\\s+(.+))?/i);\n\nif (!matches) {\n  return { action: 'ignore', message: 'No valid command found' };\n}\n\nreturn {\n  action: matches[1].toLowerCase(),\n  day_number: parseInt(matches[2]),\n  feedback: matches[3] || ''\n};"
      },
      "id": "d0e1ac6b-67a3-41bb-a5a5-c6be98bbfcf2",
      "name": "Parse Command",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        300
      ]
    },
    {
      "parameters": {
        "dataType": "string",
        "value1": "={{ $json.action }}",
        "rules": {
          "rules": [
            {
              "value2": "approve"
            },
            {
              "value2": "reject"
            },
            {
              "value2": "edit"
            }
          ]
        }
      },
      "id": "90e3cd1c-2234-45aa-bbbe-b97c6452f10b",
      "name": "Route Action",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [
        540,
        300
      ]
    },
    {
      "parameters": {
        "operation": "update",
        "sheetId": "EKI_SPREADSHEET_ID_PLACEHOLDER",
        "range": "Content Drafts!A:J",
        "matchColumns": [
          "day_number"
        ],
        "columnsToUpdate": [
          "status",
          "approval_date"
        ],
        "fieldsUi": {
          "values": [
            {
              "column": "status",
              "value": "Approved"
            },
            {
              "column": "approval_date",
              "value": "={{ new Date().toISOString() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "3be5b0cd-562a-4df4-8d41-c741e0a290ab",
      "name": "Update GSheet Approved",

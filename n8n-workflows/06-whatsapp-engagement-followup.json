{
  "name": "Eki - 06 WhatsApp Engagement Follow-up",
  "nodes": [
    {
      "id": "e30217b3-4d4a-483d-941d-316c24307e83",
      "name": "Daily 10AM Check",
      "type": "n8n-nodes-base.cronTrigger",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "hour": 10,
          "minute": 0,
          "weekday": [
            0,
            0
          ]
        }
      }
    },
    {
      "id": "8615b7fc-d29e-4c2e-92a7-8bb7cb3a5b16",
      "name": "Get All Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "operation": "getRows",
        "documentId": "={{$env.GOOGLE_SHEETS_ID}}",
        "sheetName": "Leads"
      },
      "credentials": {
        "googleSheetsOAuth2Api": "googleSheetsOAuth2Api"
      }
    },
    {
      "id": "ac0930ee-d792-42ca-b4f1-38a562704ef7",
      "name": "Find Inactive Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "jsCode": "return ($json || []).filter(l => {\n  const lastContact = l.last_wa ? new Date(l.last_wa).getTime() : 0;\n  const daysSince = (Date.now() - lastContact) / 86400000;\n  return l.status !== 'churned' && l.status !== 'unsubscribed' && daysSince >= 7;\n}).map(l => {\n  const daysSince = Math.floor((Date.now() - new Date(l.last_wa||Date.now()).getTime()) / 86400000);\n  let dayBucket;\n  if(daysSince >= 21) dayBucket = 21;\n  else if(daysSince >= 14) dayBucket = 14;\n  else if(daysSince >= 7) dayBucket = 7;\n  return {json: {...l, followup_day: dayBucket}};\n});"
      }
    },
    {
      "id": "055cd5b1-d33a-422d-9f1c-56215f45bbb8",
      "name": "Route by Days",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [
        900,
        0
      ],
      "parameters": {
        "dataType": "string",
        "value1": "={{$json.followup_day}}",
        "rules": [
          {
            "value": "7"
          },
          {
            "value": "14"
          },
          {
            "value": "21"
          }
        ]
      }
    },
    {
      "id": "06473d23-e7ba-4ad1-9121-8f23ebec23b0",
      "name": "WA 7-Day Re-engage",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{$env.WHATSAPP_PHONE_NUMBER_ID}}/messages",
        "authentication": "none",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "messaging_product",
              "value": "whatsapp"
            },
            {
              "name": "to",
              "value": "={{$json.phone}}"
            },
            {
              "name": "type",
              "value": "text"
            },
            {
              "name": "text.body",
              "value": "=Hey {{$json.name}}! \ud83d\udc4b Just checking in. Eki is helping vendors get more orders and buyers find trusted African foodstuff. No pressure, but your store/profile is waiting: https://eki.app/continue\n\nReply READY to get started or STOP to opt out."
            }
          ]
        },
        "options": {
          "headerParameters": {
            "parameters": [
              {
                "name": "Authorization",
                "value": "=Bearer {{$env.WHATSAPP_ACCESS_TOKEN}}"
              }
            ]
          }
        }
      }
    },
    {

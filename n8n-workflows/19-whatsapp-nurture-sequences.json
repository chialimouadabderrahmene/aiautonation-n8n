      "parameters": {
        "jsCode": "const norm = (v) => (v === undefined || v === null) ? '' : String(v).trim();\nconst digits = (v) => norm(v).replace(/\\D/g, '');\nconst yes = (v) => ['yes', 'true', '1', 'y'].includes(norm(v).toLowerCase());\nconst hoursSince = (iso) => { const t = Date.parse(norm(iso)); return Number.isNaN(t) ? Infinity : (Date.now() - t) / 3600000; };\nconst daysSince = (iso) => hoursSince(iso) / 24;\nconst nowIso = () => new Date().toISOString();\nconst appLink = () => norm($env.APP_DOWNLOAD_LINK);\nconst vendorLink = () => norm($env.APP_VENDOR_LINK) || appLink();\nconst r = $input.first().json || {};\nconst src = $('Loop Over Leads').first(1).json;\nconst ok = !!(r.messages && r.messages[0] && r.messages[0].id) && !r.error;\nconst lead = { ...src.lead };\nif (ok) {\n  lead.nurture_day = String(src.step_day); lead.last_nurture = nowIso(); lead.last_wa = nowIso(); lead.last_wa_error = '';\n  if (src.last_step) lead.status = 'nurturing';\n} else { lead.last_wa_error = String((r.error && (r.error.message || r.error)) || 'send_failed').slice(0, 200); }\nreturn [{ json: { lead, sent: ok, step: src.step, error: ok ? '' : lead.last_wa_error } }];"

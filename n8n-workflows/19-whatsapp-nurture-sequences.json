    {
      "parameters": {
        "jsCode": "const norm = (v) => (v === undefined || v === null) ? '' : String(v).trim();\nconst digits = (v) => norm(v).replace(/\\D/g, '');\nconst yes = (v) => ['yes', 'true', '1', 'y'].includes(norm(v).toLowerCase());\nconst hoursSince = (iso) => { const t = Date.parse(norm(iso)); return Number.isNaN(t) ? Infinity : (Date.now() - t) / 3600000; };\nconst daysSince = (iso) => hoursSince(iso) / 24;\nconst nowIso = () => new Date().toISOString();\nconst appLink = () => norm($env.APP_DOWNLOAD_LINK);\nconst vendorLink = () => norm($env.APP_VENDOR_LINK) || appLink();\nconst LEAD_FIELDS = [\"lead_id\",\"phone\",\"email\",\"name\",\"user_type\",\"user_segment\",\"country\",\"foodstuff_specialty\",\"source\",\"interest_level\",\"intent_level\",\"status\",\"opt_in\",\"opt_in_source\",\"opt_in_at\",\"opt_out_at\",\"signup_date\",\"first_contact\",\"last_message\",\"last_wa\",\"wa_day\",\"last_nurture\",\"nurture_day\",\"last_reengage\",\"reengage_step\",\"referral_code\",\"feedback_requested_date\",\"feedback_received_date\",\"last_feedback_rating\",\"last_wa_error\",\"notes\"];\nconst blankLead = () => Object.fromEntries(LEAD_FIELDS.map((f) => [f, '']));\nconst mergeLead = (existing, updates) => {\n  const out = blankLead();\n  for (const f of LEAD_FIELDS) { if (existing && existing[f] !== undefined && existing[f] !== null) out[f] = String(existing[f]); }\n  for (const f of LEAD_FIELDS) { if (updates && updates[f] !== undefined && updates[f] !== null) out[f] = String(updates[f]); }\n  return out;\n};\nconst leadIdFor = (phone, email) => digits(phone) ? 'P' + digits(phone) : (norm(email) ? 'E' + norm(email).toLowerCase() : '');\nconst tplLang = norm($env.WA_TEMPLATE_LANG) || 'en';\nconst waClean = (s) => norm(s).replace(/[\\r\\n\\t]+/g, ' ').replace(/ {5,}/g, '    ').slice(0, 900) || '-';\n// Business-initiated WhatsApp messages MUST be approved templates. Never free-form text.\nconst buildTemplate = (key, phone, params) => {\n  const name = norm($env['WA_TPL_' + key]);\n  if (!name) return { ok: false, reason: 'template_not_configured:WA_TPL_' + key };\n  const to = digits(phone);\n  if (to.length < 8 || to.length > 15) return { ok: false, reason: 'invalid_phone' };\n  return {\n    ok: true,\n    template: name,\n    payload: {\n      messaging_product: 'whatsapp', recipient_type: 'individual', to, type: 'template',\n      template: { name, language: { code: tplLang }, components: [{ type: 'body', parameters: params.map((p) => ({ type: 'text', text: waClean(p) })) }] },\n    },\n  };\n};\n// Returns '' when the lead may be contacted, otherwise the reason it must NOT be.\nconst notContactableReason = (l) => {\n  if (!yes(l.opt_in)) return 'no_opt_in';\n  if (norm(l.opt_out_at)) return 'opted_out';\n  const st = norm(l.status).toLowerCase();\n  if (['unsubscribed', 'converted', 'churned'].includes(st)) return 'status_' + st;\n  const d = digits(l.phone);\n  if (d.length < 8 || d.length > 15) return 'invalid_phone';\n  return '';\n};\n// status=lead_captured leads (engaged via WhatsApp). Vendor days 1,2,3,7,14 - Buyer days 1,3,5. Approved templates only.\nconst MAX = parseInt($env.WA_MAX_PER_RUN || '40', 10) || 40;\nconst app = () => appLink() || 'our app';\nconst ven = () => vendorLink() || 'our app';\nconst SEQ = {\n  vendor: [[1, 'NURTURE_VENDOR_D1', ven], [2, 'NURTURE_VENDOR_D2', ven], [3, 'NURTURE_VENDOR_D3', ven], [7, 'NURTURE_VENDOR_D7', ven], [14, 'NURTURE_VENDOR_D14', ven]],\n  buyer: [[1, 'NURTURE_BUYER_D1', app], [3, 'NURTURE_BUYER_D3', app], [5, 'NURTURE_BUYER_D5', app]],\n};\nconst leads = $input.all().map((i) => i.json).filter((l) => norm(l.lead_id) && norm(l.phone));\nconst out = [];\nconst missing = new Set();\nlet waiting = 0;\nfor (const raw of leads) {\n  if (norm(raw.status).toLowerCase() !== 'lead_captured') continue;\n  const seq = SEQ[norm(raw.user_type).toLowerCase()];\n  if (!seq) continue;\n  const lead = mergeLead(raw, {});\n  if (notContactableReason(lead)) continue;\n  const done = parseInt(lead.nurture_day, 10) || 0;\n  const next = seq.find((s) => s[0] > done);\n  if (!next) continue;\n  const anchor = lead.opt_in_at || lead.first_contact;\n  if (daysSince(anchor) < next[0] - 0.05) continue;\n  if (hoursSince(lead.last_nurture) < 20) continue;\n  const t = buildTemplate(next[1], lead.phone, [lead.name || 'there', next[2]()]);\n  if (!t.ok) { if (t.reason.startsWith('template_not_configured')) { missing.add(t.reason.split(':')[1]); waiting++; } continue; }\n  if (out.length >= MAX) break;\n  out.push({ json: { send: true, lead, step_day: next[0], last_step: next[0] === seq[seq.length - 1][0], step: next[1], payload: t.payload } });\n}\nif (missing.size) out.push({ json: { send: false, alert: 'Nurture blocked: ' + waiting + ' lead(s) waiting. Configure approved WhatsApp templates: ' + [...missing].join(', ') } });\nreturn out;"
      },

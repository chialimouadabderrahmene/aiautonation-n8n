      "parameters": {
        "jsCode": "const norm = (v) => (v === undefined || v === null) ? '' : String(v).trim();\nconst digits = (v) => norm(v).replace(/\\D/g, '');\nconst yes = (v) => ['yes', 'true', '1', 'y'].includes(norm(v).toLowerCase());\nconst hoursSince = (iso) => { const t = Date.parse(norm(iso)); return Number.isNaN(t) ? Infinity : (Date.now() - t) / 3600000; };\nconst daysSince = (iso) => hoursSince(iso) / 24;\nconst nowIso = () => new Date().toISOString();\nconst appLink = () => norm($env.APP_DOWNLOAD_LINK);\nconst vendorLink = () => norm($env.APP_VENDOR_LINK) || appLink();\nconst LEAD_FIELDS = [\"lead_id\",\"phone\",\"email\",\"name\",\"user_type\",\"user_segment\",\"country\",\"foodstuff_specialty\",\"source\",\"interest_level\",\"intent_level\",\"status\",\"opt_in\",\"opt_in_source\",\"opt_in_at\",\"opt_out_at\",\"signup_date\",\"first_contact\",\"last_message\",\"last_wa\",\"wa_day\",\"last_nurture\",\"nurture_day\",\"last_reengage\",\"reengage_step\",\"referral_code\",\"feedback_requested_date\",\"feedback_received_date\",\"last_feedback_rating\",\"last_wa_error\",\"notes\"];\nconst blankLead = () => Object.fromEntries(LEAD_FIELDS.map((f) => [f, '']));\nconst mergeLead = (existing, updates) => {\n  const out = blankLead();\n  for (const f of LEAD_FIELDS) { if (existing && existing[f] !== undefined && existing[f] !== null) out[f] = String(existing[f]); }\n  for (const f of LEAD_FIELDS) { if (updates && updates[f] !== undefined && updates[f] !== null) out[f] = String(updates[f]); }\n  return out;\n};\nconst leadIdFor = (phone, email) => digits(phone) ? 'P' + digits(phone) : (norm(email) ? 'E' + norm(email).toLowerCase() : '');\nconst m = $('Parse Message').first().json;\nconst existing = $input.first().json || {};\nconst now = m.timestamp || nowIso();\nconst norml = m.text.toLowerCase().replace(/[^\\p{L}\\s]/gu, '').replace(/\\s+/g, ' ').trim();\nconst stopWords = ['stop', 'unsubscribe', 'quit', 'cancel', 'opt out', 'optout', 'basta', 'stop all'];\nconst startWords = ['start', 'subscribe'];\nconst greetWords = ['hi', 'hello', 'ciao', 'hey', 'start'];\nconst buyerWords = ['buyer', 'buy', 'acquirente', 'comprare', 'customer', 'shopping'];\nconst vendorWords = ['vendor', 'sell', 'venditore', 'vendere', 'seller', 'business', 'shop owner'];\nconst wasOptedOut = norm(existing.opt_out_at) !== '' || norm(existing.status).toLowerCase() === 'unsubscribed';\nconst app = appLink();\nconst base = { lead_id: 'P' + m.phone, phone: m.phone, name: existing.name || m.sender_name || '', source: existing.source || 'whatsapp', first_contact: existing.first_contact || now, signup_date: existing.signup_date || now.slice(0, 10), last_message: now, reengage_step: '0', status: existing.status || 'new' };\nlet action = 'reply'; let step = 'unknown'; let userType = norm(existing.user_type) || 'unknown'; let intent = norm(existing.intent_level) || 'low'; let reply = '';\nconst u = { ...base };\nif (stopWords.includes(norml)) {\n  action = 'stop'; step = 'unsubscribed';\n  reply = 'You have been unsubscribed from Eki messages. Reply START anytime to re-subscribe.';\n  u.status = 'unsubscribed'; u.opt_in = 'no'; u.opt_out_at = now;\n} else if (wasOptedOut && !startWords.includes(norml)) {\n  action = 'none'; step = 'ignored_unsubscribed'; // never message an unsubscribed lead unless they send START\n} else {\n  if (wasOptedOut) { u.status = 'new'; u.opt_out_at = ''; }\n  if (greetWords.includes(norml)) {\n    step = 'greeting';\n    reply = 'Welcome to Eki!\\n\\nEki is a marketplace connecting African foodstuff vendors with buyers worldwide.\\n\\nAre you a *Buyer* or a *Vendor*?\\n\\nReply: BUYER or VENDOR\\n\\nReply STOP anytime to opt out.';\n    if (startWords.includes(norml)) { u.opt_in = 'yes'; u.opt_in_at = now; u.opt_in_source = 'inbound_whatsapp'; }\n  } else if (buyerWords.some((w) => norml.includes(w))) {\n    step = 'type_identified'; userType = 'buyer'; intent = 'medium';\n    reply = 'Great! You are interested as a Buyer.\\n\\nWhat is your full name and country?\\n\\nReply STOP anytime to opt out.';\n  } else if (vendorWords.some((w) => norml.includes(w))) {\n    step = 'type_identified'; userType = 'vendor'; intent = 'high';\n    reply = 'Awesome! You are a Vendor.\\n\\nWhat is your full name, country, and what do you sell?\\n\\nReply STOP anytime to opt out.';\n  } else {\n    step = 'info_provided'; intent = intent === 'low' ? 'medium' : intent;\n    reply = 'Thanks for the info! A member of the Eki team will follow up.' + (app ? '\\n\\nYou can also download the Eki app: ' + app : '') + '\\n\\nReply STOP anytime to opt out.';\n  }\n  if (step === 'type_identified') {\n    u.opt_in = 'yes'; u.opt_in_at = existing.opt_in_at || now; u.opt_in_source = 'inbound_whatsapp';\n    if (['', 'new', 'nurturing', 'churned', 'lead_captured'].includes(norm(u.status).toLowerCase())) u.status = 'lead_captured';\n  } else if (norm(u.status).toLowerCase() === 'churned') { u.status = 'nurturing'; }\n  u.user_type = userType; u.intent_level = intent;\n}\nconst lead = mergeLead(existing, u);\nconst convo = { timestamp: now, phone: m.phone, direction: 'inbound', message_text: m.text, reply_sent: reply, conversation_step: step, user_type: lead.user_type, intent_level: lead.intent_level, message_id: m.message_id };\nconst payload = reply ? { messaging_product: 'whatsapp', recipient_type: 'individual', to: m.phone, type: 'text', text: { preview_url: false, body: reply } } : null;\nreturn [{ json: { lead, action, step, send_reply: !!payload, payload, convo, high_intent: lead.intent_level === 'high' && action !== 'stop' && action !== 'none', reply_text: reply } }];"

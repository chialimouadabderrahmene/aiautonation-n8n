      "parameters": {
        "jsCode": "const body = $json;\nconst keyword = (body.keyword || body.text || '').toUpperCase();\nconst user = body.name || body.username || 'Unknown';\nreturn [{json:{user,keyword,platform:'instagram',source:body.source||'manychat',timestamp:new Date().toISOString()}}];"
      }
    },
    {
      "id": "a66735f5-b342-4496-a396-876d270fe0de",

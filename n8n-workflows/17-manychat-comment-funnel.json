      "parameters": {
        "jsCode": "const norm = (v) => (v === undefined || v === null) ? '' : String(v).trim();\nconst digits = (v) => norm(v).replace(/\\D/g, '');\nconst yes = (v) => ['yes', 'true', '1', 'y'].includes(norm(v).toLowerCase());\nconst hoursSince = (iso) => { const t = Date.parse(norm(iso)); return Number.isNaN(t) ? Infinity : (Date.now() - t) / 3600000; };\nconst daysSince = (iso) => hoursSince(iso) / 24;\nconst nowIso = () => new Date().toISOString();\nconst appLink = () => norm($env.APP_DOWNLOAD_LINK);\nconst vendorLink = () => norm($env.APP_VENDOR_LINK) || appLink();\nconst b = $input.first().json.body || {};\nconst keyword = norm(b.keyword || b.text).toUpperCase().replace(/[^A-Z]/g, '');\nconst name = norm(b.name || b.first_name) || 'there';\nconst username = norm(b.username || b.ig_username).replace(/^@/, '').toLowerCase().replace(/[^a-z0-9._]/g, '');\nconst vendorKeys = ['VENDOR', 'SELL', 'INFO', 'JOIN'];\nconst persona = vendorKeys.includes(keyword) ? 'vendor' : keyword === 'BUY' ? 'buyer' : 'unknown';\nconst app = appLink(); const ven = vendorLink(); const wa = norm($env.WHATSAPP_CTA_LINK);\nlet text;\nif (persona === 'vendor') text = 'Hi ' + name + '! Selling foodstuff online? Eki is a marketplace where African foodstuff vendors can reach buyers worldwide.' + (ven ? ' Start here: ' + ven : '') + (wa ? '\\nPrefer WhatsApp? ' + wa : '');\nelse if (persona === 'buyer') text = 'Hi ' + name + '! Looking for African foodstuff? Eki connects you with vendors.' + (app ? ' Browse here: ' + app : '') + (wa ? '\\nPrefer WhatsApp? ' + wa : '');\nelse text = 'Hi ' + name + '! Thanks for your comment.' + (app ? ' Learn more about Eki: ' + app : '');\nreturn [{ json: {\n  keyword, persona, name, username, known_keyword: persona !== 'unknown',\n  reply: { version: 'v2', content: { messages: [{ type: 'text', text }] } },\n} }];"
      },

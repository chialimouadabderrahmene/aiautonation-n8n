      "typeVersion": 2,
      "position": [
        900,
        0
      ],
      "parameters": {
        "chatId": "={{$json.user}}",
        "text": "=Hi {{$json.user}}! \ud83d\udc4b You're selling on IG? Eki gives you a pro storefront, secure payments, order management. Free to set up. Start here: https://eki.app/vendor"
      },
      "credentials": {
        "telegramApi": "telegramApi"
      }
    },
    {

              }
            ]
          }
        }
      }
    },
    {
      "id": "d5082aa4-e54d-4727-9dc9-28a0e52a08f8",
      "name": "Update Progress",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1500,
        0
      ],
      "parameters": {
        "jsCode": "return $json.map(l => ({json: {...l, wa_day: l.wa_day, last_wa: new Date().toISOString(), status: l.wa_day >= 3 ? 'nurturing' : 'new'}}));"
      }
    },

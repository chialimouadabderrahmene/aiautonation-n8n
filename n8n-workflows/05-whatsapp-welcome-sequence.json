      "name": "Read Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        360,
        200
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "eki-cred-gsheets",
          "name": "Eki Google Sheets"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "alwaysOutputData": true,
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "const norm = (v) => (v === undefined || v === null) ? '' : String(v).trim();\nconst digits = (v) => norm(v).replace(/\\D/g, '');\nconst yes = (v) => ['yes', 'true', '1', 'y'].includes(norm(v).toLowerCase());\nconst hoursSince = (iso) => { const t = Date.parse(norm(iso)); return Number.isNaN(t) ? Infinity : (Date.now() - t) / 3600000; };\nconst daysSince = (iso) => hoursSince(iso) / 24;\nconst nowIso = () => new Date().toISOString();\nconst appLink = () => norm($env.APP_DOWNLOAD_LINK);\nconst vendorLink = () => norm($env.APP_VENDOR_LINK) || appLink();\nconst LEAD_FIELDS = [\"lead_id\",\"phone\",\"email\",\"name\",\"user_type\",\"user_segment\",\"country\",\"foodstuff_specialty\",\"source\",\"interest_level\",\"intent_level\",\"status\",\"opt_in\",\"opt_in_source\",\"opt_in_at\",\"opt_out_at\",\"signup_date\",\"first_contact\",\"last_message\",\"last_wa\",\"wa_day\",\"last_nurture\",\"nurture_day\",\"last_reengage\",\"reengage_step\",\"referral_code\",\"feedback_requested_date\",\"feedback_received_date\",\"last_feedback_rating\",\"last_wa_error\",\"notes\"];\nconst blankLead = () => Object.fromEntries(LEAD_FIELDS.map((f) => [f, '']));\nconst mergeLead = (existing, updates) => {\n  const out = blankLead();\n  for (const f of LEAD_FIELDS) { if (existing && existing[f] !== undefined && existing[f] !== null) out[f] = String(existing[f]); }\n  for (const f of LEAD_FIELDS) { if (updates && updates[f] !== undefined && updates[f] !== null) out[f] = String(updates[f]); }\n  return out;\n};\nconst leadIdFor = (phone, email) => digits(phone) ? 'P' + digits(phone) : (norm(email) ? 'E' + norm(email).toLowerCase() : '');\nconst tplLang = norm($env.WA_TEMPLATE_LANG) || 'en';\nconst waClean = (s) => norm(s).replace(/[\\r\\n\\t]+/g, ' ').replace(/ {5,}/g, '    ').slice(0, 900) || '-';\n// Business-initiated WhatsApp messages MUST be approved templates. Never free-form text.\nconst buildTemplate = (key, phone, params) => {\n  const name = norm($env['WA_TPL_' + key]);\n  if (!name) return { ok: false, reason: 'template_not_configured:WA_TPL_' + key };\n  const to = digits(phone);\n  if (to.length < 8 || to.length > 15) return { ok: false, reason: 'invalid_phone' };\n  return {\n    ok: true,\n    template: name,\n    payload: {\n      messaging_product: 'whatsapp', recipient_type: 'individual', to, type: 'template',\n      template: { name, language: { code: tplLang }, components: [{ type: 'body', parameters: params.map((p) => ({ type: 'text', text: waClean(p) })) }] },\n    },\n  };\n};\n// Returns '' when the lead may be contacted, otherwise the reason it must NOT be.\nconst notContactableReason = (l) => {\n  if (!yes(l.opt_in)) return 'no_opt_in';\n  if (norm(l.opt_out_at)) return 'opted_out';\n  const st = norm(l.status).toLowerCase();\n  if (['unsubscribed', 'converted', 'churned'].includes(st)) return 'status_' + st;\n  const d = digits(l.phone);\n  if (d.length < 8 || d.length > 15) return 'invalid_phone';\n  return '';\n};\n// Days 1-3 welcome sequence for status=new leads. Every message is an approved template and only goes to opted-in leads.\nconst MAX = parseInt($env.WA_MAX_PER_RUN || '40', 10) || 40;\nconst appOr = () => appLink() || 'our app';\nconst STEPS = {\n  1: ['WELCOME_D1', (l) => [l.name || 'there', appOr()]],\n  2: ['WELCOME_D2', (l) => [l.name || 'there', appOr()]],\n  3: ['WELCOME_D3', (l) => [l.name || 'there', appOr()]],\n};\nconst leads = $input.all().map((i) => i.json).filter((l) => norm(l.lead_id) && norm(l.phone));\nconst out = [];\nconst missing = new Set();\nlet waiting = 0;\nfor (const raw of leads) {\n  if (norm(raw.status).toLowerCase() !== 'new') continue;\n  const day = (parseInt(raw.wa_day, 10) || 0) + 1;\n  if (day > 3) continue;\n  if (day > 1 && hoursSince(raw.last_wa) < 20) continue;\n  const lead = mergeLead(raw, {});\n  if (notContactableReason(lead)) continue;\n  const [key, params] = STEPS[day];\n  const t = buildTemplate(key, lead.phone, params(lead));\n  if (!t.ok) { if (t.reason.startsWith('template_not_configured')) { missing.add(t.reason.split(':')[1]); waiting++; } continue; }\n  if (out.length >= MAX) break;\n  out.push({ json: { send: true, lead, next_wa_day: day, step: key, payload: t.payload } });\n}\nif (missing.size) out.push({ json: { send: false, alert: 'Welcome sequence blocked: ' + waiting + ' opted-in lead(s) waiting. Configure approved WhatsApp templates: ' + [...missing].join(', ') } });\nreturn out;"
      },

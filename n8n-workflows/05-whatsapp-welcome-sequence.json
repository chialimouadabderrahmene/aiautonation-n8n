{
  "name": "Eki - 05 WhatsApp Welcome Sequence",
  "nodes": [
    {
      "id": "56b8a12b-51e9-44b4-9063-257af467f6ee",
      "name": "Daily 9AM Check",
      "type": "n8n-nodes-base.cronTrigger",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "hour": 9,
          "minute": 0,
          "weekday": [
            0,
            0
          ]
        }
      }
    },
    {
      "id": "d14de988-5b47-4108-85aa-65382d359fbe",
      "name": "Get New Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 2,
      "position": [
        300,
        0
      ],
      "parameters": {
        "operation": "getRows",
        "documentId": "={{$env.GOOGLE_SHEETS_ID}}",
        "sheetName": "Leads"
      },
      "credentials": {
        "googleSheetsOAuth2Api": "googleSheetsOAuth2Api"
      }
    },
    {
      "id": "54bf0413-dd5f-4269-9737-90a89f4af253",
      "name": "Filter Fresh Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        600,
        0
      ],
      "parameters": {
        "jsCode": "return ($json || []).filter(l => l.status === 'new' && (!l.last_wa || (Date.now() - new Date(l.last_wa).getTime()) > 86400000)).slice(0, 50).map(l => ({json: {...l, wa_day: parseInt(l.wa_day || '0') + 1}}));"
      }
    },
    {
      "id": "58f680b1-b037-4438-85f6-7a219d53b5f6",
      "name": "Route by Day",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 2,
      "position": [
        900,
        0
      ],
      "parameters": {
        "dataType": "string",
        "value1": "={{$json.wa_day}}",
        "rules": [
          {
            "value": "1"
          },
          {
            "value": "2"
          },
          {
            "value": "3"
          }
        ]
      }
    },
    {
      "id": "78c330ff-4eae-4b0f-902d-d73fab465283",
      "name": "WA Day 1 - Welcome",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{$env.WHATSAPP_PHONE_NUMBER_ID}}/messages",
        "authentication": "none",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "messaging_product",
              "value": "whatsapp"
            },
            {
              "name": "to",
              "value": "={{$json.phone}}"
            },
            {
              "name": "type",
              "value": "text"
            },
            {
              "name": "text.body",
              "value": "=Hi {{$json.name}}! We know the chaos of selling on WhatsApp - missed orders, ghost buyers, fake payment alerts. Eki was built to fix this. Here's a 1-min overview: https://eki.app/how-it-works\n\nReply BUYER or VENDOR so we can help you better."
            }
          ]
        },
        "options": {
          "headerParameters": {
            "parameters": [
              {
                "name": "Authorization",
                "value": "=Bearer {{$env.WHATSAPP_ACCESS_TOKEN}}"
              }
            ]
          }
        }
      }
    },
    {
      "id": "fc961e65-4a7f-48d7-b596-e8810abccc5e",
      "name": "WA Day 2 - Social Proof",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 2,
      "position": [
        1200,
        200

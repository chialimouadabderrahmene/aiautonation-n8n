            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Lead": {
      "main": [
        [
          {
            "node": "WhatsApp Welcome",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "WhatsApp Welcome": {
      "main": [
        [
          {
            "node": "Lead Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
